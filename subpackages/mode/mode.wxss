page {
  min-height: 100%;
  background: linear-gradient(180deg, #edf8f4 0, var(--ui-bg) 340rpx);
}

.statistics {
  box-sizing: border-box;
  padding: 34rpx 28rpx;
}

ec-canvas {
  width: 100%;
  height: 100%;
  background: transparent;
}

#mychart2 {
  display: block;
  width: 100%;
  height: 680rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 30rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-card);
}
