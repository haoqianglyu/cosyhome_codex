.page-container {
    min-height: 100vh;
    background: linear-gradient(180deg, #f7fbf9 0%, #eef5f3 100%);
    padding: 20rpx;
}

.detail-card {
    background-color: #fff;
    border: 1rpx solid var(--ui-border);
    border-radius: 24rpx;
    padding: 30rpx;
    box-shadow: var(--ui-shadow-soft);
}

.detail-state {
    display: flex;
    min-height: 620rpx;
    align-items: center;
    justify-content: center;
    color: var(--ui-text-muted);
    font-size: 27rpx;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f5f5f5;
}

.title {
    flex: 1;
    min-width: 0;
    margin-right: 20rpx;
    overflow: hidden;
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.status {
    font-size: 28rpx;
    padding: 6rpx 16rpx;
    border-radius: 8rpx;
}

.status-pending {
    color: #ff976a;
    background-color: #fff3e0;
}

.status-processing {
    color: #55c2bb;
    background-color: var(--ui-primary-soft);
}

.status-completed {
    color: #07c160;
    background-color: #e8f5e9;
}

.info-section {
    margin-bottom: 40rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
    border-left: 8rpx solid #55c2bb;
    padding-left: 16rpx;
}

.info-item {
    display: flex;
    margin-bottom: 16rpx;
    font-size: 28rpx;
}

.info-item .label {
    color: #999;
    width: 160rpx;
}

.info-item .value {
    color: #333;
    flex: 1;
}

.description {
    font-size: 28rpx;
    color: #666;
    line-height: 1.6;
    background-color: #f5faf8;
    padding: 20rpx;
    border-radius: 16rpx;
}

.attachment-list {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
}

.attachment-loading {
    padding: 30rpx 0;
    color: var(--ui-text-muted);
    font-size: 25rpx;
}

.attachment-item {
    width: 140rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.filename {
    font-size: 24rpx;
    color: #666;
    margin-top: 8rpx;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    width: 100%;
}
