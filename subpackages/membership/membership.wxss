/* pages/membership/membership.wxss */

/* Page Container */
.page-container {
  height: 100vh;
  width: 100vw;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}


/* Member Count Section */
.member-count-section {
  background: #ffffff;
  border: 1rpx solid #e8e8e8;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  text-align: left;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.member-count {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.member-count-label {
  font-size: 28rpx;
  color: #666666;
}

/* Member List Container (Scrollable) */
.member-list-container {
  flex: 1;
  height: 0; /* 关键：强制flex子元素计算高度 */
  margin-bottom: 20rpx;
}

/* --- MODIFIED & FINAL STYLES START --- */

/* Member List */
.member-list {
  padding-bottom: 20rpx;
  /* 使用 Flexbox 和 gap 属性来创建间距 */
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* Swipe Cell Styles */
.member-swipe-cell {
  border-radius: 16rpx;
  overflow: hidden;
}

/* 移除了之前尝试的 margin 方案 */

.delete-button {
  width: 80px;
  height: 100%;
  background-color: #ff3b30;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
}

.delete-button:active {
  background-color: #d93025;
}

.member-item {
  background: #ffffff;
  border: 1rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

/* --- MODIFIED & FINAL STYLES END --- */

.member-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.member-phone {
  font-size: 26rpx;
  color: #666666;
}


/* Add Member Section */
.add-member-section {
  flex-shrink: 0;
  padding: 20rpx 0 40rpx;
  position: sticky;
  bottom: 0;
  background-color: #f5f5f5;
}

.add-member-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1989fa 0%, #0066cc 100%);
  border: none;
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.4);
  transition: all 0.3s ease;
}

.add-member-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(25, 137, 250, 0.3);
}

.add-member-btn::after {
  border: none;
}
