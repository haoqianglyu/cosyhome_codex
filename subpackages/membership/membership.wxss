page { height: 100%; background: linear-gradient(180deg,#f7fbf9,#eef5f3); }
.page-container { display: flex; box-sizing: border-box; width: 100vw; height: 100vh; flex-direction: column; padding: 28rpx; background: transparent; }
.member-count-section { position: relative; flex-shrink: 0; margin-bottom: 24rpx; padding: 30rpx; overflow: hidden; border: 0; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg,#55c2bb,#55c2bb 58%,#55c2bb); box-shadow: 0 15rpx 34rpx rgba(24,128,106,.2); }
.member-count-section::after { content: ""; position: absolute; top: -80rpx; right: -40rpx; width: 220rpx; height: 220rpx; border: 1rpx solid rgba(255,255,255,.17); border-radius: 50%; box-shadow: 0 0 0 38rpx rgba(255,255,255,.04); }
.member-count { position: relative; font-size: 47rpx; font-weight: 680; }
.member-count-label { position: relative; margin-top: 7rpx; color: rgba(255,255,255,.7); font-size: 22rpx; }
.member-list-container { flex: 1; height: 0; margin-bottom: 18rpx; }
.member-list { display: flex; flex-direction: column; gap: 16rpx; padding-bottom: 18rpx; }
.member-swipe-cell { overflow: hidden; border-radius: 23rpx; }
.delete-button { display: flex; width: 80px; height: 100%; align-items: center; justify-content: center; color: #fff; background: #dc6868; font-size: 28rpx; }
.member-item { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; margin: 0; padding: 22rpx 25rpx; border: 1rpx solid var(--ui-border); border-radius: 23rpx; background: #fff; box-shadow: var(--ui-shadow-soft); }
.member-info { flex: 1; }
.member-name { color: var(--ui-text); font-size: 29rpx; font-weight: 630; }
.member-phone { margin-top: 7rpx; color: var(--ui-text-muted); font-size: 22rpx; }
.add-member-section { position: sticky; bottom: 0; flex-shrink: 0; padding: 16rpx 0 calc(18rpx + env(safe-area-inset-bottom)); background: transparent; }
.add-member-btn { display: flex; width: 100%; height: 86rpx; align-items: center; justify-content: center; border-radius: 43rpx; color: #fff; background: linear-gradient(135deg,#55c2bb,#55c2bb); box-shadow: 0 11rpx 24rpx rgba(85,194,187,.22); font-size: 29rpx; font-weight: 600; }
