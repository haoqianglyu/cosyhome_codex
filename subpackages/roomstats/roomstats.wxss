page {
  min-height: 100%;
  background: linear-gradient(180deg, #edf8f4 0, var(--ui-bg) 340rpx);
}

.panel {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.select_box {
  position: relative;
  z-index: 10;
  margin-bottom: 26rpx;
}

.select {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 92rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 22rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-soft);
}

.select_text {
  flex: 1;
  color: var(--ui-text);
  font-size: 29rpx;
  font-weight: 600;
}

.select_img {
  width: 48rpx;
  height: 48rpx;
  transition: transform 0.25s;
}

.select_img_rotate {
  transform: rotate(90deg);
}

.option_box {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  overflow-y: auto;
  border: 0 solid var(--ui-border);
  border-radius: 22rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-card);
  opacity: 0;
  transition: height 0.25s, margin-top 0.25s, opacity 0.18s;
}

.option_box--open {
  margin-top: 10rpx;
  border-width: 1rpx;
  opacity: 1;
}

.option {
  display: block;
  box-sizing: border-box;
  height: 60rpx;
  padding: 10rpx 24rpx;
  border-bottom: 1rpx solid var(--ui-border);
  color: var(--ui-text-secondary);
  font-size: 27rpx;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.page-state {
  display: flex;
  min-height: 520rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-muted);
  font-size: 25rpx;
}

.page-state-title {
  color: var(--ui-text-secondary);
  font-size: 29rpx;
  font-weight: 600;
}

.page-state-copy {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.nav-li {
  overflow: hidden;
  border: 1rpx solid var(--ui-border);
  border-radius: 26rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-soft);
}

.room-card-title {
  display: flex;
  min-height: 70rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  color: var(--ui-text);
  font-size: 28rpx;
  font-weight: 650;
  text-align: center;
}

.table {
  overflow-x: auto;
}

.tr {
  display: flex;
  min-width: 700rpx;
  min-height: 88rpx;
  align-items: stretch;
}

.td,
.th,
.th_first {
  display: flex;
  flex: 1;
  min-width: 112rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx 5rpx;
  text-align: center;
  font-size: 21rpx;
}

.td {
  color: var(--ui-text-secondary);
  border-top: 1rpx solid var(--ui-border);
}

.th {
  color: var(--ui-text-secondary);
  background: #f2faf7;
}

.th_first {
  color: #fff;
  background: linear-gradient(180deg, #55c2bb, #55c2bb);
  font-weight: 600;
}
