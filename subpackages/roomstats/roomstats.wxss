/* pages/rooms/rooms.wxss */
page {
  height: 100%;
}
.panel {
  height: 100%;
}
.panel .select_box {
  background: #fff;
  z-index: 10;
  position: relative;
  height: 70rpx;
}
.panel .select_box .select {
  box-sizing: border-box;
  width: 100%;
  height: 70rpx;
  border: 1px solid #efefef;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}
.panel .select_box .select .select_text {
  font-size: 30rpx;
  flex: 1;
}
.panel .select_box .select .select_img {
  width: 60rpx;
  height: 100%;
  display: block;
  margin-right: -20rpx;
  transition: transform 0.3s;
}
.panel .select_box .select .select_img_rotate {
  transform: rotate(90deg);
}
.panel .select_box .option_box {
  position: absolute;
  top: 70rpx;
  width: 100%;
  border: 1px solid #efefef;
  box-sizing: border-box;
  height: 0;
  overflow-y: auto;
  border-top: 0;
  background: #fff;
  padding-left: 20rpx;
  transition: height 0.3s;
}
.panel .select_box .option {
  display: block;
  line-height: 40rpx;
  font-size: 30rpx;
  border-bottom: 1px solid #efefef;
  padding: 10rpx;
}
.panel .nav-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0px 30rpx 0px;
  justify-content: space-between;
}
.panel .nav-li {
  border-radius: 25rpx;
  width: 100%;
  margin: 0 1vw 40rpx;
  z-index: 1;
  background-color: white;
  box-shadow: 2px 2px 10px #dcdcdc;
}
.panel .text-center {
  margin-top: 15rpx;
  margin-bottom: 15rpx;
}
.panel .table {
  border: 0px solid darkgray;
}
.panel .tr {
  display: flex;
  width: 100%;
  justify-content: center;
  height: 3rem;
  align-items: center;
}
.panel .td {
  width: 40%;
  justify-content: center;
  text-align: center;
}
.panel .th_first {
  width: 40%;
  justify-content: center;
  background: #7cbfbf;
  color: #fff;
  display: flex;
  height: 3rem;
  align-items: center;
}
.panel .th {
  width: 40%;
  justify-content: center;
  display: flex;
  height: 3rem;
  align-items: center;
}
