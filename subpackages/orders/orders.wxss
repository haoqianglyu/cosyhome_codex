/* 页面级别设置 */
page {
  height: 100vh;
  background-color: #f5f5f5;
}

/* Page Container */
.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}


.page-wrapper {
    flex: 1;
    padding: 40rpx 30rpx 30rpx 30rpx;
    box-sizing: border-box;
    overflow: hidden;
  }
  
  .order-list-container {
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 60rpx;
    box-sizing: border-box;
  }
  
  .order-card {
    background: #ffffff;
    border: 1rpx solid #e8e8e8;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    font-size: 26rpx;
    color: #333;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .order-card:active {
    transform: scale(0.98);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  }
  
  .order-card:last-child {
    margin-bottom: 0;
  }
  
  .card-header {
    display: flex;
    align-items: center;
    margin-bottom: 10rpx;
  }
  
  .user-info {
    display: flex;
    align-items: center;
  }
  
  .user-name {
    font-size: 30rpx;
    color: #333;
    font-weight: 600;
    margin-left: 10rpx;
  }
  
  .create-time-row {
    margin-bottom: 20rpx;
  }

  .create-time {
    font-size: 24rpx;
    color: #666;
    font-weight: 500;
  }
  
  .card-body {
    margin-bottom: 20rpx;
  }
  
  .order-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    word-break: break-all;
    line-height: 1.4;
  }
  
  .service-type {
    word-break: break-all;
    flex: 1;
    padding-right: 20rpx;
    color: #666;
    font-weight: 500;
  }
  
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .order-status {
    font-weight: bold;
    white-space: nowrap;
  }
  
  /* 评价状态样式 */
  .rating-status {
    font-size: 24rpx;
    font-weight: 600;
    white-space: nowrap;
    padding: 8rpx 16rpx;
    border-radius: 12rpx;
    text-align: center;
  }
  
  /* 已评价状态 */
  .rating-completed {
    background-color: #e8f5e8;
    color: #07c160;
    border: 1rpx solid #07c160;
  }
  
  /* 未评价状态 */
  .rating-pending {
    background-color: #fff3e0;
    color: #ff9800;
    border: 1rpx solid #ff9800;
  }
  
  /* 已完成状态颜色 */
  .status-completed {
    color: #07c160;
  }
  
  /* 列表为空时的提示 */
  .empty-state {
    text-align: center;
    color: #999;
    padding: 80rpx 0;
    font-size: 28rpx;
  }
