.page-container {
  --button-primary-background-color: #55c2bb;
  --button-primary-border-color: #55c2bb;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #f7fbf9 0%, #eef5f3 100%);
}

.tabs-header {
  display: flex;
  background-color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  border-bottom: 1rpx solid var(--ui-border);
  position: relative;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: var(--ui-primary);
  font-weight: bold;
}

.tab-item .indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: var(--ui-primary);
  border-radius: 2rpx;
}

.content-swiper {
  flex: 1;
  height: calc(100vh - 88rpx);
}

.scroll-view {
  height: 100%;
}

.list-container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.card {
  background-color: #fff;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--ui-shadow-soft);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.header-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  max-width: calc(100% - 100rpx);
}

.header-left .title {
  display: -webkit-box;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  flex: 1;
}

.status {
  font-size: 26rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-pending {
  color: #ff976a;
  background-color: #fff3e0;
}

.status-processing {
  color: #55c2bb;
  background-color: #e8f5f6;
}

.status-completed {
  color: #07c160;
  background-color: #e8f5e9;
}

.status-unknown {
  color: #999;
  background-color: #f5f5f5;
}

.card-body {
  font-size: 28rpx;
  color: #666;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row .label {
  color: #999;
  width: 140rpx;
}

.info-row .value {
  color: #333;
  flex: 1;
}

.rating-row {
  margin-top: 16rpx;
  text-align: right;
}

.rating-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.rating-pending {
  color: #ff976a;
  border: 1rpx solid #ff976a;
}

.rating-completed {
  color: #07c160;
  border: 1rpx solid #07c160;
}

.empty-state {
  padding-top: 100rpx;
  text-align: center;
}


/* Order List Specific Styles (Replicated from orders.wxss) */
.order-card {
  background: #ffffff;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: var(--ui-shadow-soft);
  transition: all 0.3s ease;
}

.order-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.order-card .card-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  border-bottom: none;
  /* Override default card-header */
  padding-bottom: 0;
  /* Override default card-header */
}

.user-info {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-left: 10rpx;
}

.create-time-row {
  margin-bottom: 20rpx;
}

.create-time {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.order-card .card-body {
  margin-bottom: 20rpx;
}

.order-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  word-break: break-all;
  line-height: 1.4;
}

.service-type {
  word-break: break-all;
  flex: 1;
  padding-right: 20rpx;
  color: #666;
  font-weight: 500;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rating-status {
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  text-align: center;
}

.rating-completed {
  background-color: #e8f5e8;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.rating-pending {
  background-color: #fff3e0;
  color: #ff9800;
  border: 1rpx solid #ff9800;
}

.feedback-btn-container {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  z-index: 100;
  box-shadow: 0 8rpx 22rpx rgba(24, 145, 119, 0.24);
  border-radius: 999px;
}
