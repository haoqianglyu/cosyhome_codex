/* pages/addMember/addMember.wxss */

/* Page Container */
.page-container {
  min-height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f7fbf9 0%, #eef5f3 100%);
}


/* Family Section: 移除 align-items: center */
.family-section {
  display: flex;
  flex-direction: column;
  margin-top: 8vh;
}

/* Family Image: 移除固定的 height */
.family-image {
  width: 100vw;
  margin-bottom: 60rpx;
}

.family-text {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

/* Form Section */
.form-section {
  margin: 0 30rpx 40rpx;
  padding: 38rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--ui-border);
  border-radius: 28rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-soft);
}

.input-container {
  margin-bottom: 30rpx;
  width: 100%;
  max-width: 500rpx;
}

/* Input Field Styling */
.input-field {
  color: #333333 !important;
  font-size: 32rpx;
  padding: 24rpx 30rpx;
}

.input-placeholder {
  color: #999999 !important;
  font-size: 32rpx;
}


/* Save Button */
.save-btn {
  width: 100%;
  max-width: 500rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #55c2bb 0%, #55c2bb 100%);
  border: none;
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(85, 194, 187, 0.22);
  transition: all 0.3s ease;
  margin-top: 20rpx;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(85, 194, 187, 0.18);
}

/* disabled 状态的样式可以保留，以备将来可能需要 */
.save-btn:disabled {
  background: #cccccc;
  color: #666666;
  box-shadow: none;
}

.save-btn::after {
  border: none;
}
