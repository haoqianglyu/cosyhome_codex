/* pages/addMember/addMember.wxss */

/* Page Container */
.page-container {
  min-height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}


/* Family Section: 移除 align-items: center */
.family-section {
  display: flex;
  flex-direction: column;
  margin-top: 8vh;
}

/* Family Image: 移除固定的 height */
.family-image {
  width: 100vw;
  margin-bottom: 60rpx;
}

.family-text {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

/* Form Section */
.form-section {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
}

.input-container {
  margin-bottom: 30rpx;
  width: 100%;
  max-width: 500rpx;
}

/* Input Field Styling */
.input-field {
  color: #333333 !important;
  font-size: 32rpx;
  padding: 24rpx 30rpx;
}

.input-placeholder {
  color: #999999 !important;
  font-size: 32rpx;
}


/* Save Button */
.save-btn {
  width: 100%;
  max-width: 500rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #1989fa 0%, #0066cc 100%);
  border: none;
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.4);
  transition: all 0.3s ease;
  margin-top: 20rpx;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(25, 137, 250, 0.3);
}

/* disabled 状态的样式可以保留，以备将来可能需要 */
.save-btn:disabled {
  background: #cccccc;
  color: #666666;
  box-shadow: none;
}

.save-btn::after {
  border: none;
}