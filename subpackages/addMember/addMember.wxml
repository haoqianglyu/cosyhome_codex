<view class="page-container">
  
  <view class="family-section">
    <image class="family-image" 
           src="https://cosyminiprogram.oss-cn-hangzhou.aliyuncs.com/cloud_pic/cosyfamily.png" 
           mode="widthFix">
    </image>
    <view class="family-text">添加家庭成员更方便！</view>
  </view>
  
  <view class="form-section">
    <view class="input-container">
      <van-field
        value="{{memberName}}"
        placeholder="输入成员姓名"
        border="{{false}}"
        bind:change="onNameChange"
        custom-style="background: #ffffff; border-radius: 12rpx; color: #333333; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);"
        input-class="input-field"
        placeholder-class="input-placeholder"
      />
    </view>
    
    <view class="input-container">
      <van-field
        value="{{memberPhone}}"
        placeholder="输入成员手机号"
        border="{{false}}"
        type="number"
        bind:change="onPhoneChange"
        custom-style="background: #ffffff; border-radius: 12rpx; color: #333333; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);"
        input-class="input-field"
        placeholder-class="input-placeholder"
      />
    </view>
    
    
    <button class="save-btn" bindtap="onSaveMember">
      保存
    </button>
  </view>
  
  <van-toast id="van-toast" />
</view>