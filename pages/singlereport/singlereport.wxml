<view class="report-page">
  <view class="report-hero">
    <view class="hero-eyebrow">ROOM INSIGHT</view>
    <view class="hero-title">房间数据分析</view>
    <view class="hero-copy">查看当前房间的运行与环境数据</view>

    <picker class="date-picker" mode="date" fields="month" value="{{date}}" start="{{start_date}}" end="{{end_date}}" bindchange="bindDateChange">
      <view class="date-picker-inner">
        <view>
          <view class="date-label">分析月份</view>
          <view class="date-value">{{date}}</view>
        </view>
        <view class="date-action">切换月份</view>
      </view>
    </picker>
  </view>

  <view class="section-title">分析模块</view>
  <view class="report-list">
    <navigator open-type="navigate" hover-class="card-hover" url="/subpackages/mode/mode" class="report-card">
      <view class="card-index">01</view>
      <view class="card-copy">
        <view class="card-title">运行模式占比</view>
        <view class="card-desc">查看不同运行模式的时间分布</view>
      </view>
      <view class="card-arrow">→</view>
    </navigator>

    <navigator open-type="navigate" hover-class="card-hover" url="/pages/roomstats2/roomstats2" class="report-card cyan-card">
      <view class="card-index">02</view>
      <view class="card-copy">
        <view class="card-title">环境量统计</view>
        <view class="card-desc">查看温度、湿度与露点统计</view>
      </view>
      <view class="card-arrow">→</view>
    </navigator>
  </view>
</view>
