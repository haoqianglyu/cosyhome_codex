<wxs module="numberUtil" src="../../utils/numberUtil.wxs"></wxs>
<view class="panel">
    <view wx:if="{{loading}}" class="page-state">正在读取环境量数据...</view>
    <view wx:elif="{{!content.length}}" class="page-state">
      <view class="page-state-title">{{loadError || '暂无环境量数据'}}</view>
      <view class="page-state-copy">下拉页面可重新加载</view>
    </view>
    <view wx:else class='nav-list margin-top'>
        <view class="nav-li" wx:for="{{content}}" wx:key="_key">
          
            <!-- <view class="text-center margin-bottom text-lg  text-grey">
                {{item.name}}
            </view> -->
    
            <view class="table">
                <view class="tr">
                  <view class="th_first">参数</view>
                  <view class="th_first">温度</view>
                  <view class="th_first">湿度</view>
                  <view class="th_first">露点</view>
    
                </view>
                <view class="tr">
                  <view class="th">单位</view>
                  <view class="th">℃</view>
                  <view class="th">%</view>
                  <view class="th">℃</view>
                </view>
                
                  <view class="tr">
                    <view class="td">均值</view>
                    <view class="td">{{numberUtil.hasValue(item.avgTemperature)?numberUtil.toFix(item.avgTemperature):"-"}}</view>
                    <view class="td">{{numberUtil.hasValue(item.avgHumidity)?numberUtil.toFix(item.avgHumidity):"-"}}</view>
                    <view class="td">{{numberUtil.hasValue(item.avgDewPoint)?numberUtil.toFix(item.avgDewPoint):"-"}}</view>
                  </view>
                  <view class="tr">
                    <view class="td">标准差</view>
                    <view class="td">{{numberUtil.hasValue(item.sdTemperature)?numberUtil.toFix(item.sdTemperature):"-"}}</view>
                    <view class="td">{{numberUtil.hasValue(item.sdHumidity)?numberUtil.toFix(item.sdHumidity):"-"}}</view>
                    <view class="td">{{numberUtil.hasValue(item.sdDewPoint)?numberUtil.toFix(item.sdDewPoint):"-"}}</view>
                
                  </view>
                
              </view>
            
        </view>
    </view>
</view>
