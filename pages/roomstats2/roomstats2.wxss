/* pages/rooms/rooms.wxss */
page {
  height: 100vh;
  /* 设置为视口高度，确保填充整个屏幕 */
  display: flex;
  /* 使用 Flexbox 布局 */
  align-items: center;
  /* 垂直居中子元素 */
  justify-content: center;
  /* 水平居中子元素 */
}
.panel {
  width: 100%;
  /* 占据所有可用空间 */
}
.panel .nav-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0px 30rpx 0px;
  justify-content: space-between;
  width: 100%;
  /* 可选，如果你想要 `.nav-list` 占据所有可用空间 */
}
.panel .nav-li {
  border-radius: 25rpx;
  width: 100%;
  margin: 0 1vw 40rpx;
  z-index: 1;
  background-color: white;
  box-shadow: 2px 2px 10px #dcdcdc;
}
.panel .text-center {
  margin-top: 15rpx;
  margin-bottom: 15rpx;
}
.panel .table {
  border: 0px solid darkgray;
  border-radius: 25rpx;
  overflow: hidden;
  /* 确保内部元素不会超出圆角边界 */
}
.panel .tr {
  display: flex;
  width: 100%;
  justify-content: center;
  height: 3rem;
  align-items: center;
}
.panel .td {
  width: 40%;
  justify-content: center;
  text-align: center;
}
.panel .th_first {
  width: 40%;
  justify-content: center;
  background: #7cbfbf;
  color: #fff;
  display: flex;
  height: 3rem;
  align-items: center;
}
.panel .th {
  width: 40%;
  justify-content: center;
  display: flex;
  height: 3rem;
  align-items: center;
}
