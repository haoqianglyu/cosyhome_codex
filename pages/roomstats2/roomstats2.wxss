page {
  min-height: 100%;
  background: linear-gradient(180deg, #edf8f4 0, var(--ui-bg) 340rpx);
}

.panel {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 38rpx 28rpx;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.nav-li {
  overflow: hidden;
  border: 1rpx solid var(--ui-border);
  border-radius: 26rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-card);
}

.table {
  overflow: hidden;
}

.tr {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  align-items: stretch;
}

.td,
.th,
.th_first {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 14rpx 5rpx;
  text-align: center;
  font-size: 23rpx;
}

.td {
  color: var(--ui-text-secondary);
  border-top: 1rpx solid var(--ui-border);
}

.th {
  color: var(--ui-text-secondary);
  background: #f2faf7;
}

.th_first {
  color: #fff;
  background: linear-gradient(180deg, #55c2bb, #55c2bb);
  font-weight: 600;
}
