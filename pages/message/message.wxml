<view class="message-page">
  <view class="tab-shell">
    <view class="switch-tab">
      <view
        wx:for="{{arr}}"
        wx:key="*this"
        class="tab-item {{currentTab == index ? 'tab-active' : ''}}"
        data-current="{{index}}"
        bindtap="swichNav"
      >
        <text>{{item}}</text>
        <view class="tab-indicator"></view>
      </view>
    </view>
  </view>

  <swiper class="message-swiper" current="{{currentTab}}" duration="300" bindchange="bindChange">
    <swiper-item>
      <scroll-view scroll-y class="message-scroll" scroll-top="{{scrollTop}}">
        <view wx:if="{{listData.length === 0}}" class="empty-state">
          <view class="empty-icon cuIcon-notification"></view>
          <view class="empty-title">暂无提示消息</view>
          <view class="empty-description">新的提示消息会显示在这里</view>
        </view>

        <view wx:else class="message-list">
          <view class="message-card notice-card" wx:for="{{listData}}" wx:key="id">
            <view class="card-header">
              <view class="card-type">
                <view class="type-icon cuIcon-notificationfill"></view>
                <text>提示消息</text>
              </view>
              <text class="message-time">{{item.time}}</text>
            </view>
            <view class="message-content">{{item.content}}</view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <scroll-view scroll-y class="message-scroll" scroll-top="{{scrollTop}}">
        <view wx:if="{{listData2.length === 0}}" class="empty-state">
          <view class="empty-icon cuIcon-service"></view>
          <view class="empty-title">暂无服务公告</view>
          <view class="empty-description">设备服务与故障信息会显示在这里</view>
        </view>

        <view wx:else class="message-list">
          <view class="message-card service-card" wx:for="{{listData2}}" wx:key="id">
            <view class="card-header service-header">
              <view class="device-info">
                <view class="device-icon cuIcon-settingsfill"></view>
                <view class="device-copy">
                  <text class="device-label">设备</text>
                  <text class="device-name">{{item.equipmentInfo || '未知设备'}}</text>
                </view>
              </view>
              <text class="message-time service-time">{{item.time}}</text>
            </view>
            <view class="content-divider"></view>
            <view class="content-label">公告内容</view>
            <view class="message-content service-content">{{item.content}}</view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
