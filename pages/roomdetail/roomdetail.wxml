<view class="room-status-bar" style="height: {{statusBarHeight}}px;"></view>
<view class="room-custom-nav">
  <view class="room-nav-back" aria-role="button" aria-label="返回房间列表" bindtap="BackPage">
    <view class="room-nav-back-icon" aria-hidden="true"></view>
    <text>返回</text>
  </view>
  <view class="room-nav-title">房间控制</view>
  <view class="room-nav-placeholder"></view>
</view>

<view class="room-hero">
  <view class="room-name-block">
    <text class="room-title">{{roomName}}</text>
    <text
      class="iconfont icon-modify room-edit-icon"
      aria-role="button"
      aria-label="修改房间名称"
      bindtap="modalinput"
    ></text>
  </view>
  <view class="panel-quick-control" wx:if="{{canOff === true}}">
    <text class="panel-quick-label">温控面板</text>
    <i-switch size="small" bind:change="onChange" value="{{switch1}}">
      <view slot="open">开</view>
      <view slot="close">关</view>
    </i-switch>
  </view>
</view>

<view class="roompage">
  <view class="data-card">
    <view class="card-half left-half" wx:if="{{realtemp !== '' || realhumidity !== ''}}">
      <view class="card-label">当前环境</view>
      <view class="current-temperature">
        {{realtemp === '' ? '--' : realtemp}}<text class="unit">℃</text>
      </view>
      <view class="humidity-row" wx:if="{{realhumidity !== '' && !isXLLG}}">
        <text class="iconfont icon-humidity"></text>
        <text>湿度</text>
        <text class="humidity-value">{{realhumidity}}%</text>
      </view>
    </view>

    <view class="card-half right-half" wx:if="{{sliderable && !(isHeatingDehumidify && airConditionerModeName === '制冷')}}">
      <view class="card-label">设定温度</view>
      <view class="target-temperature">
        {{showtemp}}<text class="unit">℃</text>
      </view>
      <view class="temperature-stepper">
        <view
          class="step-button {{minusStatus === 'disabled' ? 'step-button--disabled' : ''}}"
          aria-role="button"
          aria-label="降低设定温度"
          bindtap="bindMinus"
        >−</view>
        <view
          class="step-button {{plusStatus === 'disabled' ? 'step-button--disabled' : ''}}"
          aria-role="button"
          aria-label="升高设定温度"
          bindtap="bindPlus"
        >＋</view>
      </view>
    </view>
  </view>

  <view class="control-card">
    <view class="control-row" wx:if="{{!isHeatingDehumidify}}">
      <view class="control-label">
        <view class="control-label-icon control-label-icon--energy"><text class="cuIcon-creative"></text></view>
        <text>节能</text>
      </view>
      <i-switch size="small" bind:change="onChangePower" value="{{switch_power}}">
        <view slot="open">开</view>
        <view slot="close">关</view>
      </i-switch>
    </view>

    <view class="control-row">
      <view class="control-label">
        <view class="control-label-icon control-label-icon--lock"><text class="{{switch_lock ? 'cuIcon-lock' : 'cuIcon-unlock'}}"></text></view>
        <text>锁定</text>
      </view>
      <i-switch size="small" bind:change="onChangeLock" value="{{switch_lock}}">
        <view slot="open">开</view>
        <view slot="close">关</view>
      </i-switch>
    </view>

    <view class="control-row" wx:if="{{hasWindControl && !(isHeatingDehumidify && airConditionerModeName === '制冷')}}">
      <view class="control-label">
        <view class="control-label-icon control-label-icon--wind">
          <view class="mini-fan" aria-hidden="true">
            <view class="mini-fan-blade mini-fan-blade--1"></view>
            <view class="mini-fan-blade mini-fan-blade--2"></view>
            <view class="mini-fan-blade mini-fan-blade--3"></view>
            <view class="mini-fan-blade mini-fan-blade--4"></view>
            <view class="mini-fan-hub"></view>
          </view>
        </view>
        <text>风速</text>
      </view>
      <view class="segmented-control">
        <view
          wx:for="{{windLevels}}"
          wx:key="*this"
          class="segment-item {{currentButton == index ? 'segment-item--active' : ''}}"
          aria-role="button"
          aria-label="选择风速{{index + 1}}"
          bindtap="switchButton"
          data-index="{{index}}"
        >{{index + 1}}</view>
        <view
          wx:if="{{isAutoWindLevel}}"
          class="segment-item {{currentButton == 100 ? 'segment-item--active' : ''}}"
          aria-role="button"
          aria-label="选择自动风速"
          bindtap="switchButton"
          data-index="100"
        >自动</view>
      </view>
    </view>

    <view class="control-row control-row--terminal" wx:if="{{workModes.length > 0 && !(isHeatingDehumidify && airConditionerModeName === '制冷')}}">
      <view class="control-label">
        <view class="control-label-icon control-label-icon--terminal"><text class="cuIcon-cascades"></text></view>
        <text>末端类型</text>
      </view>
      <view class="terminal-options">
        <view
          wx:for="{{workModes}}"
          wx:key="optionName"
          class="terminal-option {{item.isSelect ? 'terminal-option--active' : ''}} {{!item.isChange ? 'terminal-option--disabled' : ''}}"
          aria-role="button"
          aria-label="选择{{item.optionName}}"
          data-index="{{index}}"
          bindtap="toggleSelection"
        >{{item.optionName}}</view>
      </view>
    </view>
  </view>

  <view class="statistics">
    <ec-canvas id="mychart1" canvas-id="mychart1" ec="{{ec1}}"></ec-canvas>
  </view>
</view>
