page { min-height: 100%; background: linear-gradient(180deg,#f7fbf9,#edf5f2); }
.role-page { box-sizing: border-box; min-height: 100vh; padding: 56rpx 28rpx; }
.role-heading { padding: 12rpx 8rpx 40rpx; }
.heading-eyebrow { color: var(--ui-primary); font-size: 17rpx; font-weight: 650; letter-spacing: 3rpx; }
.heading-title { margin-top: 11rpx; color: var(--ui-text); font-size: 40rpx; font-weight: 680; }
.heading-copy { margin-top: 10rpx; color: var(--ui-text-muted); font-size: 22rpx; }
.role-card { position: relative; display: flex; align-items: center; min-height: 210rpx; margin-bottom: 22rpx; padding: 30rpx; overflow: hidden; border: 1rpx solid var(--ui-border); border-radius: 30rpx; background: #fff; box-shadow: var(--ui-shadow); }
.user-card { color: #fff; border: 0; background: linear-gradient(135deg,#55c2bb,#55c2bb 58%,#55c2bb); }
.card-orbit { position: absolute; top: -100rpx; right: -50rpx; width: 250rpx; height: 250rpx; border: 1rpx solid rgba(255,255,255,.18); border-radius: 50%; box-shadow: 0 0 0 40rpx rgba(255,255,255,.04); }
.role-icon { position: relative; display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 90rpx; height: 90rpx; margin-right: 24rpx; border-radius: 28rpx; color: var(--ui-primary); background: var(--ui-primary-soft); font-size: 42rpx; }
.user-card .role-icon { color: #fff; background: rgba(255,255,255,.15); }
.role-content { position: relative; flex: 1; min-width: 0; }
.role-name { color: var(--ui-text); font-size: 32rpx; font-weight: 650; }
.user-card .role-name { color: #fff; }
.role-desc { margin-top: 9rpx; color: var(--ui-text-muted); font-size: 21rpx; }
.user-card .role-desc { color: rgba(255,255,255,.72); }
.permission-chip { display: inline-flex; margin-top: 18rpx; padding: 7rpx 14rpx; border-radius: 18rpx; color: #55c2bb; background: rgba(222,249,239,.92); font-size: 19rpx; }
.visitor-chip { color: var(--ui-primary-dark); background: var(--ui-primary-soft); }
.role-arrow { position: relative; color: rgba(255,255,255,.75); font-size: 42rpx; }
.visitor-card .role-arrow { color: #a5b3ae; }
.security-note { display: flex; align-items: flex-start; margin-top: 34rpx; padding: 22rpx; border-radius: 20rpx; color: var(--ui-text-muted); background: rgba(255,255,255,.62); font-size: 21rpx; line-height: 1.6; }
.security-note .cuIcon-safe { margin: 3rpx 12rpx 0 0; color: var(--ui-primary); font-size: 27rpx; }
