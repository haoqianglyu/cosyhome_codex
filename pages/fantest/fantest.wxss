page {
  width: 100%;
  min-height: 100%;
  background:
    radial-gradient(circle at 90% 6%, rgba(116, 206, 174, 0.2), transparent 34%),
    linear-gradient(180deg, #f5fbf8 0%, #eaf3f0 100%);
}

.room-demo-page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 90rpx;
}

.room-hero {
  padding: 18rpx 10rpx 12rpx;
}

.room-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.room-title {
  min-width: 0;
  overflow: hidden;
  color: #193b35;
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-name-block {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.room-edit-icon {
  flex-shrink: 0;
  margin-left: 10rpx;
  color: #8a8a8a;
  font-size: 38rpx;
}

.room-edit-icon--pressed {
  opacity: 0.55;
}

.panel-quick-control {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 16rpx;
  padding: 12rpx 14rpx 12rpx 20rpx;
  border: 1rpx solid rgba(85, 194, 187, 0.1);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 22rpx rgba(31, 96, 82, 0.08);
}

.panel-quick-copy {
  margin-right: 14rpx;
  text-align: right;
}

.panel-quick-label {
  color: #35544c;
  font-size: 20rpx;
  font-weight: 600;
}

.demo-card {
  margin-top: 24rpx;
}

.environment-card,
.system-card,
.terminal-card,
.analytics-card {
  box-sizing: border-box;
  padding: 32rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(85, 194, 187, 0.1);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 18rpx 50rpx rgba(31, 96, 82, 0.1);
}

.primary-metrics {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 0 20rpx 28rpx;
}

.primary-metric {
  min-width: 0;
  flex: 1;
}

.metric-label {
  display: flex;
  align-items: center;
  color: #7c8d88;
  font-size: 24rpx;
}

.metric-label-icon {
  margin-right: 9rpx;
  color: #55c2bb;
  font-size: 29rpx;
}

.primary-value-row {
  display: flex;
  align-items: flex-end;
  margin-top: 6rpx;
}

.primary-value {
  color: #17372f;
  font-size: 90rpx;
  font-weight: 430;
  line-height: 1.08;
}

.primary-unit {
  margin: 0 0 12rpx 6rpx;
  color: #55c2bb;
  font-size: 32rpx;
  font-weight: 600;
}

.humidity-ring {
  display: flex;
  width: 154rpx;
  height: 154rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 14rpx solid #55c2bb;
  border-left-color: rgba(31, 96, 82, 0.1);
  border-radius: 50%;
  transform: rotate(-28deg);
}

.humidity-ring-inner {
  text-align: center;
  transform: rotate(28deg);
}

.humidity-value {
  color: #17372f;
  font-size: 36rpx;
  font-weight: 650;
}

.humidity-label {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  color: #83938e;
  font-size: 19rpx;
}

.humidity-label-icon {
  margin-right: 5rpx;
  color: #55c2bb;
  font-size: 22rpx;
}

.dew-point-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(54, 96, 86, 0.1);
}

.secondary-value {
  color: #21433b;
  font-size: 29rpx;
  font-weight: 650;
  white-space: nowrap;
}

.secondary-value text {
  color: #8a9995;
  font-size: 17rpx;
  font-weight: 500;
}

.secondary-label {
  color: #899894;
  font-size: 20rpx;
  white-space: nowrap;
}

.fan-card {
  box-sizing: border-box;
  padding: 34rpx 30rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(85, 194, 187, 0.1);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 50rpx rgba(31, 96, 82, 0.12);
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-title {
  color: #17372f;
  font-size: 34rpx;
  font-weight: 650;
}

.rpm-label {
  padding: 8rpx 18rpx;
  border-radius: 28rpx;
  color: #55c2bb;
  background: #e4f5ef;
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.fan-content {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
}

.fan-shell {
  position: relative;
  display: flex;
  width: 260rpx;
  height: 260rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #d7f1e9, #f7fcfa);
  box-shadow:
    inset 8rpx 8rpx 18rpx rgba(85, 194, 187, 0.1),
    inset -8rpx -8rpx 18rpx rgba(255, 255, 255, 0.9),
    0 12rpx 28rpx rgba(85, 194, 187, 0.1);
}

.fan-ring {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid rgba(85, 194, 187, 0.16);
  border-radius: 50%;
}

.fan-ring--outer {
  width: 226rpx;
  height: 226rpx;
}

.fan-ring--inner {
  width: 202rpx;
  height: 202rpx;
  border-color: rgba(85, 194, 187, 0.09);
}

.fan-rotor {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  transform-origin: center;
  will-change: transform;
}

.fan-blade {
  position: absolute;
  top: 5rpx;
  left: 60rpx;
  width: 60rpx;
  height: 87rpx;
  border-radius: 70% 38% 64% 35%;
  background: linear-gradient(145deg, #55c2bb, #55c2bb);
  box-shadow: inset -5rpx -5rpx 10rpx rgba(0, 81, 69, 0.12);
  transform-origin: 30rpx 85rpx;
}

.fan-blade--1 {
  transform: rotate(0deg);
}

.fan-blade--2 {
  transform: rotate(90deg);
}

.fan-blade--3 {
  transform: rotate(180deg);
}

.fan-blade--4 {
  transform: rotate(270deg);
}

.fan-hub {
  position: absolute;
  top: 67rpx;
  left: 67rpx;
  width: 46rpx;
  height: 46rpx;
  box-sizing: border-box;
  border: 8rpx solid #55c2bb;
  border-radius: 50%;
  background: #55c2bb;
  box-shadow: 0 0 0 7rpx rgba(85, 194, 187, 0.1);
}

.fan-rotor--level-1 {
  animation: fan-spin 2.2s linear infinite;
}

.fan-rotor--level-2 {
  animation: fan-spin 1.25s linear infinite;
}

.fan-rotor--level-3 {
  animation: fan-spin 0.7s linear infinite;
}

.fan-rotor--auto {
  animation: fan-auto 3.4s ease-in-out infinite;
}

.fan-rotor--off {
  animation: none;
  opacity: 0.46;
  transform: rotate(12deg);
}

@keyframes fan-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes fan-auto {
  0% {
    transform: rotate(0deg);
  }
  30% {
    transform: rotate(180deg);
  }
  70% {
    transform: rotate(900deg);
  }
  100% {
    transform: rotate(1440deg);
  }
}

.fan-summary {
  min-width: 0;
  flex: 1;
  margin-left: 34rpx;
}

.level-title {
  color: #17372f;
  font-size: 52rpx;
  font-weight: 700;
}

.airflow {
  display: flex;
  align-items: center;
  height: 58rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(85, 194, 187, 0.05);
}

.air-wave {
  flex: 1;
  opacity: 0.2;
  color: #55c2bb;
  font-size: 52rpx;
  line-height: 40rpx;
  text-align: center;
}

.airflow--active .air-wave {
  animation: airflow-move 1.8s ease-in-out infinite;
}

.airflow--active .air-wave--2 {
  animation-delay: 0.2s;
}

.airflow--active .air-wave--3 {
  animation-delay: 0.4s;
}

@keyframes airflow-move {
  0%,
  100% {
    opacity: 0.22;
    transform: translateX(-10rpx);
  }
  50% {
    opacity: 0.9;
    transform: translateX(10rpx);
  }
}

.level-controls {
  display: flex;
  justify-content: space-between;
  margin-top: 42rpx;
}

.level-button {
  min-width: 0;
  height: 72rpx;
  flex: 1;
  margin: 0 6rpx;
  padding: 0 8rpx;
  border: 1rpx solid #dbe9e5;
  border-radius: 38rpx;
  color: #70817d;
  background: rgba(246, 250, 249, 0.92);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 72rpx;
}

.level-button--active {
  border-color: transparent;
  color: #fff;
  background: #55c2bb;
  box-shadow: 0 8rpx 18rpx rgba(85, 194, 187, 0.24);
}

.control-list {
  margin-top: 20rpx;
}

.control-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
}

.control-icon {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.control-icon--energy {
  color: #55c2bb;
  background: #e4f8ef;
}

.control-icon--lock {
  color: #d18a25;
  background: #fff3de;
}

.control-copy {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.control-title {
  color: #1d3c35;
  font-size: 28rpx;
  font-weight: 650;
}

.control-divider {
  height: 1rpx;
  margin-left: 92rpx;
  background: rgba(47, 85, 76, 0.1);
}

.mock-switch {
  position: relative;
  width: 88rpx;
  height: 48rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border-radius: 26rpx;
  background: #d9e1df;
  transition: background 180ms ease;
}

.mock-switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 3rpx 9rpx rgba(27, 56, 50, 0.18);
  transition: transform 180ms ease;
}

.mock-switch--on {
  background: #55c2bb;
}

.mock-switch--on .mock-switch-knob {
  transform: translateX(40rpx);
}

.terminal-options {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx -6rpx -8rpx;
}

.terminal-option {
  margin: 0 6rpx 12rpx;
  padding: 17rpx 28rpx;
  border: 1rpx solid #dbe7e4;
  border-radius: 32rpx;
  color: #71827d;
  background: #f4f8f7;
  font-size: 24rpx;
  font-weight: 550;
}

.terminal-option--active {
  border-color: #55c2bb;
  color: #fff;
  background: #55c2bb;
  box-shadow: 0 8rpx 18rpx rgba(85, 194, 187, 0.18);
}

.analytics-tabs {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.analytics-tab {
  padding: 12rpx 16rpx;
  border: 1rpx solid #dce8e5;
  border-radius: 28rpx;
  color: #7b8c87;
  background: rgba(247, 250, 249, 0.9);
  font-size: 20rpx;
}

.analytics-tab--active {
  border-color: #55c2bb;
  color: #fff;
  background: #55c2bb;
}

.mock-chart {
  position: relative;
  height: 280rpx;
  margin-top: 24rpx;
  padding: 0 10rpx 42rpx;
  box-sizing: border-box;
}

.chart-grid {
  position: absolute;
  right: 10rpx;
  left: 10rpx;
  height: 1rpx;
  background: rgba(40, 91, 79, 0.1);
}

.chart-grid--1 {
  top: 22%;
}

.chart-grid--2 {
  top: 48%;
}

.chart-grid--3 {
  top: 74%;
}

.chart-bars {
  position: absolute;
  top: 0;
  right: 14rpx;
  bottom: 42rpx;
  left: 14rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.chart-bar {
  width: 26rpx;
  min-height: 18rpx;
  border-radius: 14rpx 14rpx 5rpx 5rpx;
  background: linear-gradient(180deg, #55c2bb, #55c2bb);
  box-shadow: 0 5rpx 12rpx rgba(13, 139, 121, 0.13);
}

.chart-labels {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: space-between;
  color: #91a09c;
  font-size: 18rpx;
}

.temperature-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 34rpx 30rpx 36rpx;
  overflow: hidden;
  border: 1rpx solid rgba(85, 194, 187, 0.1);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 18rpx 50rpx rgba(31, 96, 82, 0.12);
}

.temperature-gauge-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  margin-top: 12rpx;
}

.temperature-gauge {
  display: block;
  width: 100%;
  height: 560rpx;
}

.gauge-center {
  position: absolute;
  top: 49%;
  left: 50%;
  width: 340rpx;
  pointer-events: none;
  text-align: center;
  transform: translate(-50%, -48%);
}

.gauge-label {
  color: #7a8a86;
  font-size: 24rpx;
}

.gauge-value-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-top: 5rpx;
}

.gauge-value {
  color: #17372f;
  font-size: 86rpx;
  font-weight: 500;
  line-height: 1.1;
}

.gauge-unit {
  margin: 0 0 10rpx 7rpx;
  color: #e39a29;
  font-size: 34rpx;
  font-weight: 650;
}

.gauge-status {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.gauge-status .status-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.gauge-status--heating {
  color: #e39a29;
}

.gauge-status--cooling {
  color: #318fc5;
}

.gauge-status--stable {
  color: #55c2bb;
}

.gauge-limit {
  position: absolute;
  bottom: 36rpx;
  color: #93a19d;
  font-size: 21rpx;
}

.gauge-limit--min {
  left: 36rpx;
}

.gauge-limit--max {
  right: 36rpx;
}

.temperature-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.temperature-button {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: #fff;
  background: #55c2bb;
  box-shadow: 0 10rpx 24rpx rgba(85, 194, 187, 0.22);
  font-size: 50rpx;
  font-weight: 400;
  line-height: 96rpx;
}

.temperature-button:active {
  background: #55c2bb;
  transform: scale(0.96);
}

.temperature-hint {
  flex: 1;
  padding: 0 20rpx;
  color: #84938f;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 350px) {
  .room-demo-page {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .environment-card,
  .system-card,
  .terminal-card,
  .analytics-card {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .room-title {
    font-size: 40rpx;
  }

  .room-edit-icon {
    font-size: 34rpx;
  }

  .panel-quick-control {
    padding-left: 14rpx;
  }

  .panel-quick-copy {
    display: none;
  }

  .primary-value {
    font-size: 76rpx;
  }

  .humidity-ring {
    width: 136rpx;
    height: 136rpx;
  }

  .fan-content {
    flex-direction: column;
  }

  .fan-summary {
    width: 100%;
    margin: 28rpx 0 0;
    text-align: center;
  }

  .level-controls {
    flex-wrap: wrap;
  }

  .level-button {
    min-width: 29%;
    margin-bottom: 12rpx;
  }

  .temperature-card {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .gauge-center {
    width: 300rpx;
  }

  .gauge-value {
    font-size: 72rpx;
  }

  .analytics-tab {
    padding-right: 10rpx;
    padding-left: 10rpx;
    font-size: 18rpx;
  }
}
