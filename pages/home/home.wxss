page {
  height: 100%;
}
sup {
  font-size: 18rpx;
  vertical-align: text-top;
  margin-left: 5rpx;
}
.panel {
  background-position: center;
  background-size: 100% 100%;
  height: 100%;
}
.panel .home-top {
  position: relative;
  z-index: 10;
  padding: 30rpx 30rpx 0;
}
.panel .project-name {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-bottom: 32rpx;
  color: #2d3634;
  font-size: 30rpx;
  font-weight: 600;
}
.panel .project-name text {
  max-width: 610rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.panel .project-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  transition: transform 0.3s;
}
.panel .project-arrow--open {
  transform: rotate(90deg);
}
.panel .project-dropdown {
  position: absolute;
  top: 92rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 30;
  box-sizing: border-box;
  margin: 0;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 40rpx rgba(21, 79, 69, 0.1);
  animation: projectDropdownIn 0.2s ease;
}
@keyframes projectDropdownIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.panel .project-search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-bottom: 16rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  color: #73807d;
  background: rgba(85, 194, 187, 0.06);
}
.panel .project-search input {
  flex: 1;
  height: 76rpx;
  margin-left: 12rpx;
  color: #2d3634;
  font-size: 28rpx;
}
.panel .project-list-scroll {
  width: 100%;
  max-height: 300rpx;
}
.panel .project-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 8rpx;
}
.panel .project-chip {
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
  color: #55615e;
  background: rgba(85, 194, 187, 0.06);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.panel .project-chip--active {
  color: #fff;
  background: #55c2bb;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(85, 194, 187, 0.2);
}
.panel .mode-weather-row {
  display: flex;
  align-items: center;
  min-height: 82rpx;
}
.panel .mode-pill {
  display: flex;
  align-items: center;
  max-width: 570rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 16rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 60rpx;
  color: #55c2bb;
  background: rgba(228, 245, 239, 0.92);
  box-shadow:
    8rpx 8rpx 16rpx rgba(85, 194, 187, 0.12),
    -8rpx -8rpx 16rpx rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}
.panel .mode-pill:active {
  background: #dcf0e9;
  box-shadow:
    inset 6rpx 6rpx 12rpx rgba(85, 194, 187, 0.12),
    inset -6rpx -6rpx 12rpx rgba(255, 255, 255, 0.9);
}
.panel .mode-pill text:last-child {
  overflow: hidden;
  text-overflow: ellipsis;
}
.panel .mode-pill-icon {
  flex-shrink: 0;
  margin-right: 8rpx;
  font-size: 36rpx;
}
.panel .online-tip {
  margin-left: 16rpx;
  color: #e27a6d;
  font-size: 24rpx;
}
.panel .weather-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 82rpx;
  margin-left: auto;
  flex-shrink: 0;
}
.panel .top .halflogo {
  margin-top: 2vh;
  margin-bottom: 1vh;
  padding-left: 20%;
  padding-right: 20%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.panel .top .deviceData {
  height: 34vh;
}
.panel .top .deviceData .wx-swiper-dots.wx-swiper-dots-horizontal {
  top: 65%;
}
.panel .top .deviceData .large-sup {
  font-size: 20rpx;
  /* 你可以根据需求调整这个值 */
}
.panel .top .deviceData .temperature {
  text-align: center;
  margin-bottom: 2.5vh;
}
.panel .top .deviceData .temperature text {
  color: #55c2bb;
  font-size: 80rpx;
  font-weight: 400;
}
.panel .top .deviceData .deviceName {
  opacity: 0.7e;
  font-weight: 350;
  text-align: center;
  font-size: 35rpx;
  margin-bottom: 30rpx;
  color: #aaa;
}
.panel .top .deviceData .center {
  opacity: 0.7e;
  display: flex;
  margin: auto;
  width: 78%;
  font-weight: 310;
  text-align: center;
  font-size: 32rpx;
}
.panel .top .deviceData .center .txt {
  font-size: 45rpx;
  font-weight: 310;
}
.panel .top .deviceData .center .humidity {
  flex: 33%;
}
.panel .top .deviceData .center .PM2_5 {
  flex: 33%;
}
.panel .top .deviceData .center .CO {
  flex: 33%;
}
.panel .top .home-actions {
  position: fixed;
  right: 0;
  bottom: calc(166rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 20;
}

.panel .top .home_mode {
  display: flex;
  width: auto;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.panel .top .home-status-entry {
  display: flex;
  width: 206rpx;
  height: 78rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  padding: 0 18rpx 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(39, 84, 74, 0.11);
  backdrop-filter: blur(8px);
}

.panel .top .home-status-entry:active,
.panel .top .home-timer-entry:active {
  transform: scale(0.98);
}

.panel .top .home-status-entry-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #55c2bb;
  box-shadow: 0 7rpx 18rpx rgba(85, 194, 187, 0.22);
}

.panel .top .home-status-entry-icon .iconfont {
  font-size: 28rpx;
}

.panel .top .home-status-entry-title {
  flex: 1;
  margin-left: 15rpx;
  color: #29443e;
  font-size: 25rpx;
  font-weight: 650;
}

.panel .top .home-status-entry-arrow {
  color: #9bb0aa;
  font-size: 32rpx;
  line-height: 1;
}

.panel .top .home-timer-entry {
  display: flex;
  width: 206rpx;
  height: 78rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  padding: 0 18rpx 0 10rpx;
  margin-left: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(39, 84, 74, 0.11);
  backdrop-filter: blur(8px);
}

.panel .top .home-timer-entry-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #55c2bb;
  box-shadow: 0 7rpx 18rpx rgba(85, 194, 187, 0.22);
}

.panel .top .home-timer-entry-icon .iconfont {
  font-size: 28rpx;
}

.panel .top .home-timer-entry-label {
  flex: 1;
  margin-left: 15rpx;
  color: #29443e;
  font-size: 25rpx;
  font-weight: 650;
}
.panel .filter {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx auto 0;
  color: #52645f;
  font-weight: 400;
  text-align: center;
  font-size: 24rpx;
}

.panel .filter .day {
  margin-left: 12rpx;
  color: #52645f;
  font-size: 24rpx;
  font-weight: 400;
}

.panel .filter .filter-unit {
  margin-left: 4rpx;
  color: #52645f;
  font-size: 24rpx;
  font-weight: 400;
}

.panel .filter .day--expired {
  color: #d9534f;
}
.divider {
  width: 6rpx;
  background-color: #55c2bb;
  /* 根据需要调整高度和其他样式 */
}

/* 在家 / 离家状态底部弹层 */
.home-mode-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1100;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 48, 44, 0.28);
  backdrop-filter: blur(5px);
  animation: home-mode-overlay-in 0.22s ease;
}

.home-mode-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 42rpx calc(34rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 44rpx 44rpx 0 0;
  background:
    radial-gradient(circle at 88% 5%, rgba(85, 194, 187, 0.2), transparent 32%),
    rgba(246, 251, 249, 0.97);
  box-shadow: 0 -20rpx 60rpx rgba(32, 73, 64, 0.15);
  animation: home-mode-sheet-in 0.28s ease-out;
}

.home-mode-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 8rpx;
  background: rgba(80, 111, 103, 0.18);
}

.home-mode-sheet-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.home-mode-sheet-eyebrow {
  color: #55c2bb;
  font-size: 17rpx;
  font-weight: 650;
  letter-spacing: 4rpx;
}

.home-mode-sheet-title {
  margin-top: 6rpx;
  color: #213c36;
  font-size: 36rpx;
  font-weight: 680;
}

.home-mode-sheet-close {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #79908a;
  background: rgba(255, 255, 255, 0.72);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.home-presence-options {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
}

.home-presence-option {
  display: flex;
  width: 340rpx;
  align-items: center;
}

.home-presence-ring {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 5rpx solid rgba(95, 128, 120, 0.1);
  border-radius: 50%;
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
}

.home-presence-ring--active {
  border-color: #55c2bb;
  box-shadow:
    0 0 0 6rpx rgba(85, 194, 187, 0.08),
    0 10rpx 28rpx rgba(85, 194, 187, 0.18);
  transform: scale(1.03);
}

.home-presence-ring--loading {
  border-color: rgba(85, 194, 187, 0.18);
  border-top-color: #55c2bb;
  animation: home-presence-spin 0.8s linear infinite;
}

.home-presence-ring--loading .home-presence-icon {
  animation: home-presence-counter-spin 0.8s linear infinite;
}

.home-presence-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #42635b;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: inset 0 0 0 1rpx rgba(85, 194, 187, 0.08);
}

.home-presence-ring--active .home-presence-icon {
  color: #fff;
  background: #55c2bb;
}

.home-presence-icon .iconfont {
  font-size: 48rpx;
}

.home-presence-copy {
  margin-left: 30rpx;
}

.home-presence-title {
  color: #263f39;
  font-size: 34rpx;
  font-weight: 620;
}

.home-presence-caption {
  margin-top: 5rpx;
  color: #899893;
  font-size: 20rpx;
}

.home-presence-connector {
  width: 2rpx;
  height: 24rpx;
  margin: 4rpx 0 4rpx -218rpx;
  background: linear-gradient(180deg, rgba(85, 194, 187, 0.3), rgba(85, 194, 187, 0.05));
}

.home-mode-timer-row {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(85, 194, 187, 0.1);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.7);
}

.home-mode-timer-icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #55c2bb;
  background: rgba(85, 194, 187, 0.11);
}

.home-mode-timer-icon .iconfont {
  font-size: 30rpx;
}

.home-mode-timer-copy {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.home-mode-timer-title {
  color: #2b4640;
  font-size: 25rpx;
  font-weight: 620;
}

.home-mode-timer-caption {
  margin-top: 4rpx;
  color: #899893;
  font-size: 18rpx;
}

.home-mode-timer-arrow {
  color: #9eb0ab;
  font-size: 38rpx;
}

@keyframes home-mode-overlay-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes home-mode-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes home-presence-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes home-presence-counter-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}
/* ====================================
   弹层透明背景
==================================== */
.weather-overlay {
  position: fixed;
  /* 保持固定定位，确保背景层覆盖整个页面 */
  top: 0;
  /* 背景从页面顶部开始 */
  background: rgba(64, 64, 64, 0.6);
  /* 透明的淡灰色背景 */
  display: flex;
  justify-content: center;
  align-items: flex-start;
  /* 内容居上对齐 */
  z-index: 999;
  width: 100vw;
  /* 确保背景覆盖整个页面的宽度 */
  height: 100vh;
  /* 确保背景覆盖整个页面的高度 */
}
.weather-box {
  position: relative;
  min-width: 420rpx;
  left: 100rpx;
  top: 140rpx;
  padding: 40rpx 30rpx;
  background: rgba(47, 47, 47, 0.85);
  /* 弹框的背景色 */
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  color: white;
  margin-top: 100rpx;
  /* 确保弹框在天气图标下方 */
}
/* 关闭按钮 */
.close-btn {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: bold;
  color: white;
  /* 关闭按钮文字颜色 */
}
/* ====================================
   内容区样式（白色文字居中等）
==================================== */
/* 地点信息 */
.location {
  display: flex;
  align-items: center;
}
.location .location-text {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
/* 天气图标 */
.weather-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15rpx 0;
}
/* 温度 */
.temperature2 {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  /* 白色文字 */
  margin-top: 10rpx;
  /* 温度与天气之间的间隔 */
}
/* 天气情况 */
.weather-condition {
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 10rpx;
  color: white;
  /* 白色文字 */
}
/* 湿度 */
.humidity2 {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-top: 10rpx;
  /* 湿度与天气情况之间的间隔 */
}
.humidity2 .iconfont {
  margin-right: 10rpx;
}
.humidity2 .humidity-value {
  margin-left: auto;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
/* 露点 */
.dew-point2 {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-top: 10rpx;
  /* 露点与湿度之间的间隔 */
}
.dew-point2 .iconfont {
  margin-right: 10rpx;
}
.dew-point2 .dew-point-value {
  margin-left: auto;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
/* PM2.5 */
.pm252 {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-top: 10rpx;
  /* PM2.5 与露点之间的间隔 */
}
.pm252 .iconfont {
  margin-right: 10rpx;
}
.pm252 .pm25-value {
  margin-left: auto;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
