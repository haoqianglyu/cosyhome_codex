page {
  height: 100%;
}
sup {
  font-size: 18rpx;
  vertical-align: text-top;
  margin-left: 5rpx;
}
.panel {
  background-position: center;
  background-size: 100% 100%;
  height: 100%;
}
.panel .select_box {
  background: #fff;
  z-index: 10;
  position: relative;
  height: 5.4vh;
}
.panel .select_box .select {
  box-sizing: border-box;
  width: 100%;
  height: 5.4vh;
  border: 1px solid #efefef;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}
.panel .select_box .select .select_text {
  font-size: 30rpx;
  flex: 1;
}
.panel .select_box .select .select_img {
  width: 60rpx;
  height: 100%;
  display: block;
  margin-right: -20rpx;
  transition: transform 0.3s;
}
.panel .select_box .select .select_img_rotate {
  transform: rotate(90deg);
}
.panel .select_box .option_box {
  position: absolute;
  top: 5.4vh;
  width: 100%;
  border: 1px solid #efefef;
  box-sizing: border-box;
  height: 0;
  overflow-y: auto;
  border-top: 0;
  background: #fff;
  padding-left: 20rpx;
  transition: height 0.3s;
}
.panel .select_box .option {
  display: block;
  line-height: 3vh;
  font-size: 30rpx;
  border-bottom: 1px solid #efefef;
  padding: 0.76vh;
}
.panel .top .mode-navigator {
  display: flex;
  align-items: center;
  /* 竖直方向居中对齐 */
}
.panel .top .flex.justify-start {
  margin-top: 4vh;
  margin-left: 70rpx;
  color: #55c2bb;
  font-size: 40rpx;
}
.panel .top .mode-row {
  display: flex;
  justify-content: space-between;
  /* 左右两端 */
  align-items: center;
  margin-top: 4vh;
  padding: 0 30rpx;
  /* 给两端一些内边距 */
}
.panel .top .halflogo {
  margin-top: 2vh;
  margin-bottom: 1vh;
  padding-left: 20%;
  padding-right: 20%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.panel .top .deviceData {
  height: 34vh;
}
.panel .top .deviceData .wx-swiper-dots.wx-swiper-dots-horizontal {
  top: 65%;
}
.panel .top .deviceData .large-sup {
  font-size: 20rpx;
  /* 你可以根据需求调整这个值 */
}
.panel .top .deviceData .temperature {
  text-align: center;
  margin-bottom: 2.5vh;
}
.panel .top .deviceData .temperature text {
  color: #55c2bb;
  font-size: 80rpx;
  font-weight: 400;
}
.panel .top .deviceData .deviceName {
  opacity: 0.7e;
  font-weight: 350;
  text-align: center;
  font-size: 35rpx;
  margin-bottom: 30rpx;
  color: #aaa;
}
.panel .top .deviceData .center {
  opacity: 0.7e;
  display: flex;
  margin: auto;
  width: 78%;
  font-weight: 310;
  text-align: center;
  font-size: 32rpx;
}
.panel .top .deviceData .center .txt {
  font-size: 45rpx;
  font-weight: 310;
}
.panel .top .deviceData .center .humidity {
  flex: 33%;
}
.panel .top .deviceData .center .PM2_5 {
  flex: 33%;
}
.panel .top .deviceData .center .CO {
  flex: 33%;
}
.panel .top .home_mode {
  display: flex;
  margin: 9.5vh auto 0 auto;
  padding: 0 30rpx;
}
.panel .top .home_mode .athome {
  margin: 0 auto;
  padding: 20rpx;
  text-align: center;
  color: grey;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50px;
}
.panel .top .home_mode .leavehome {
  padding: 20rpx;
  color: grey;
  text-align: center;
  margin: 0 auto;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50px;
}
.panel .top .home_mode .clock {
  padding: 20rpx;
  color: grey;
  text-align: center;
  margin: 0 auto;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50px;
}
.panel .top .home_mode text {
  font-size: 70rpx;
  color: grey;
}
.panel .filter {
  margin-top: 4vh;
  color: black;
  font-weight: 310;
  text-align: center;
  font-size: 32rpx;
}
.divider {
  width: 6rpx;
  background-color: #55c2bb;
  /* 根据需要调整高度和其他样式 */
}
/* ====================================
   弹层透明背景
==================================== */
.weather-overlay {
  position: fixed;
  /* 保持固定定位，确保背景层覆盖整个页面 */
  top: 0;
  /* 背景从页面顶部开始 */
  background: rgba(64, 64, 64, 0.6);
  /* 透明的淡灰色背景 */
  display: flex;
  justify-content: center;
  align-items: flex-start;
  /* 内容居上对齐 */
  z-index: 999;
  width: 100vw;
  /* 确保背景覆盖整个页面的宽度 */
  height: 100vh;
  /* 确保背景覆盖整个页面的高度 */
}
.weather-box {
  position: relative;
  min-width: 420rpx;
  left: 100rpx;
  top: 140rpx;
  padding: 40rpx 30rpx;
  background: rgba(47, 47, 47, 0.85);
  /* 弹框的背景色 */
  border-radius: 20rpx;
  text-align: center;
  font-size: 30rpx;
  color: white;
  margin-top: 100rpx;
  /* 确保弹框在天气图标下方 */
}
/* 关闭按钮 */
.close-btn {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: bold;
  color: white;
  /* 关闭按钮文字颜色 */
}
/* ====================================
   内容区样式（白色文字居中等）
==================================== */
/* 地点信息 */
.location {
  display: flex;
  align-items: center;
}
.location .location-text {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
/* 天气图标 */
.weather-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15rpx 0;
}
/* 温度 */
.temperature2 {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  /* 白色文字 */
  margin-top: 10rpx;
  /* 温度与天气之间的间隔 */
}
/* 天气情况 */
.weather-condition {
  text-align: center;
  font-size: 32rpx;
  margin-bottom: 10rpx;
  color: white;
  /* 白色文字 */
}
/* 湿度 */
.humidity2 {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-top: 10rpx;
  /* 湿度与天气情况之间的间隔 */
}
.humidity2 .iconfont {
  margin-right: 10rpx;
}
.humidity2 .humidity-value {
  margin-left: auto;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
/* 露点 */
.dew-point2 {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-top: 10rpx;
  /* 露点与湿度之间的间隔 */
}
.dew-point2 .iconfont {
  margin-right: 10rpx;
}
.dew-point2 .dew-point-value {
  margin-left: auto;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
/* PM2.5 */
.pm252 {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-top: 10rpx;
  /* PM2.5 与露点之间的间隔 */
}
.pm252 .iconfont {
  margin-right: 10rpx;
}
.pm252 .pm25-value {
  margin-left: auto;
  font-size: 28rpx;
  color: white;
  /* 白色文字 */
}
