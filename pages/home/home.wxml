<!-- pages/index/index.wxml（完整） -->
<view class="panel" style='background-image: url("https://cosyminiprogram.oss-cn-hangzhou.aliyuncs.com/cloud_pic/bg7.png");'>
  <!-- 项目切换 + 模式 + 天气 -->
  <view class="home-top">
    <view class="project-name" aria-role="button" aria-label="选择项目" catchtap="selectTap">
      <text>{{showname}}</text>
      <image class="project-arrow {{show ? 'project-arrow--open' : ''}}" src="/icons/gobottom.png"></image>
    </view>

    <view class="project-dropdown" wx:if="{{show}}">
      <view class="project-search">
        <text class="cuIcon-search"></text>
        <input type="text" placeholder="搜索项目" confirm-type="search" name="project" bindinput="getProject" />
      </view>
      <scroll-view class="project-list-scroll" scroll-y="true">
        <view class="project-chip-group">
          <view
            class="project-chip {{item.id == selectedProjectId ? 'project-chip--active' : ''}}"
            aria-role="button"
            aria-label="选择项目 {{item.name}}"
            wx:for="{{searchedList}}"
            wx:key="id"
            wx:for-index="projectIndex"
            data-index="{{projectIndex}}"
            catchtap="optionTap"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="mode-weather-row">
      <navigator wx:if="{{projectReady}}" class="mode-pill" open-type="navigate" url="/pages/modeselect/modeselect" hover-class="none">
        <text class="iconfont icon-mode{{mode_icon}} mode-pill-icon"></text>
        <text>{{show_mode}}</text>
      </navigator>
      <view class="online-tip" wx:if="{{offline}}">(设备不在线)</view>
      <view class="weather-btn" aria-role="button" aria-label="查看天气" wx:if="{{weatherIconName && !offline}}" bindtap="openWeatherBox">
        <iconfont name="{{weatherIconName}}" size="40" />
      </view>
    </view>
  </view>

  <view class="project-load-state" wx:if="{{!projectReady}}">{{selectedProjectId ? (offline ? "设备离线，暂无法读取状态" : "正在读取项目状态，请稍候") : "暂无项目可查看"}}</view>
  <!-- 顶部区域 -->
  <view class="top">
    <!-- LOGO -->
    <view class="halflogo">
      <image class="logo" src="../../images/half_logo.png" mode="widthFix" />
    </view>
    <!-- 设备数据滑块 -->
    <swiper class="deviceData" indicator-dots="true">
      <block wx:for="{{deviceData}}" wx:key="deviceId">
        <swiper-item>
          <view class="swiper-item {{item}}">
            <view class="temperature">
              <text>{{item.temperature}}℃</text>
            </view>
            <view class="deviceName">{{item.deviceName}}</view>
            <!-- 新两联供项目：湿度 + 露点 -->
            <view class="center" wx:if="{{isXinLiangLianGong}}">
              <!-- 湿度 -->
              <view class="humidity" wx:if="{{item.humidity != 65536}}">
                <view class="txt">
                  {{item.humidity}}
                  <sup class="large-sup">%</sup>
                </view>
                <view>室内湿度</view>
              </view>
              <!-- 分隔 -->
              <view class="divider" wx:if="{{item.humidity != 65536}}"></view>
              <!-- 露点 -->
              <view class="PM2_5">
                <view class="txt">
                  {{item.dewPoint}}
                  <sup class="large-sup">℃</sup>
                </view>
                <view>室内露点</view>
              </view>
            </view>
            <!-- 其他项目：湿度 + PM2.5 + CO₂ -->
            <view class="center" wx:else>
              <!-- 湿度 -->
              <view class="humidity" wx:if="{{item.humidity != 65536}}">
                <view class="txt">
                  {{item.humidity}}
                  <sup class="large-sup">%</sup>
                </view>
                <view>室内湿度</view>
              </view>
              <!-- 分隔 -->
              <view class="divider" wx:if="{{item.humidity != 65536 && item.pm2_5 != 65536}}"></view>
              <!-- PM2.5 -->
              <view class="PM2_5" wx:if="{{item.pm2_5 != 65536}}">
                <view class="txt">
                  {{item.pm2_5}}
                  <sup class="large-sup">μg/m³</sup>
                </view>
                <view>室内PM2.5</view>
              </view>
              <!-- 分隔 -->
              <view class="divider" wx:if="{{(item.pm2_5 != 65536 && item.co2 != 65536) || (item.humidity != 65536 && item.co2 != 65536)}}"></view>
              <!-- CO₂ -->
              <view class="CO" wx:if="{{item.co2 != 65536}}">
                <view class="txt">
                  {{item.co2}}
                  <sup class="large-sup">PPM</sup>
                </view>
                <view>室内CO₂</view>
              </view>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    <view class="home-actions" wx:if="{{projectReady}}">
      <!-- 当前在家状态入口 + 独立定时入口 -->
      <view class="home_mode">
        <view class="home-status-entry" aria-role="button" aria-label="切换在家状态" bindtap="openHomeModeSheet">
          <view class="home-status-entry-icon">
            <text class="iconfont {{home_mode ? 'icon-huijiamoshi' : 'icon-lijiamoshi'}}"></text>
          </view>
          <view class="home-status-entry-title">{{home_mode ? '在家' : '离家'}}</view>
          <text class="home-status-entry-arrow">›</text>
        </view>
        <view class="home-timer-entry {{clock_on ? 'home-timer-entry--active' : ''}}" aria-role="button" aria-label="设置定时" wx:if="{{hasclock}}" bindtap="clock">
          <view class="home-timer-entry-icon">
            <text class="iconfont icon-clock"></text>
          </view>
          <view class="home-timer-entry-label">定时</view>
          <text class="home-status-entry-arrow">›</text>
        </view>
      </view>
      <!-- 滤网剩余 -->
      <view class="filter" wx:if="{{filter!=''}}">
        <text>滤网剩余有效期:</text>
        <text class="day {{filter > 0 ? '' : 'day--expired'}}">{{filter}}</text>
        <text class="filter-unit">天</text>
      </view>
    </view>
  </view>

  <!-- 在家 / 离家状态选择 -->
  <view
    class="home-mode-overlay"
    aria-role="button"
    aria-label="关闭在家状态选择"
    wx:if="{{showHomeModeSheet}}"
    bindtap="closeHomeModeSheet"
    catchtouchmove="noop"
  >
    <view class="home-mode-sheet" catchtap="noop">
      <view class="home-mode-sheet-handle"></view>
      <view class="home-mode-sheet-heading">
        <view>
          <view class="home-mode-sheet-eyebrow">HOME STATUS</view>
          <view class="home-mode-sheet-title">选择在家状态</view>
        </view>
        <view class="home-mode-sheet-close" aria-role="button" aria-label="关闭" catchtap="closeHomeModeSheet">×</view>
      </view>

      <view class="home-presence-options">
        <view class="home-presence-option" aria-role="button" aria-label="切换为在家模式" data-mode="home" catchtap="selectHomeMode">
          <view class="home-presence-ring {{home_mode ? 'home-presence-ring--active' : ''}} {{homeModePending === 'home' ? 'home-presence-ring--loading' : ''}}">
            <view class="home-presence-icon">
              <text class="iconfont icon-huijiamoshi"></text>
            </view>
          </view>
          <view class="home-presence-copy">
            <view class="home-presence-title">在家</view>
            <view class="home-presence-caption">{{homeModePending === 'home' ? '正在切换…' : (home_mode ? '当前状态' : '点击切换')}}</view>
          </view>
        </view>

        <view class="home-presence-connector"></view>

        <view class="home-presence-option" aria-role="button" aria-label="切换为离家模式" data-mode="away" catchtap="selectHomeMode">
          <view class="home-presence-ring {{!home_mode ? 'home-presence-ring--active' : ''}} {{homeModePending === 'away' ? 'home-presence-ring--loading' : ''}}">
            <view class="home-presence-icon">
              <text class="iconfont icon-lijiamoshi"></text>
            </view>
          </view>
          <view class="home-presence-copy">
            <view class="home-presence-title">离家</view>
            <view class="home-presence-caption">{{homeModePending === 'away' ? '正在切换…' : (!home_mode ? '当前状态' : '点击切换')}}</view>
          </view>
        </view>
      </view>

      <view class="home-mode-timer-row" aria-role="button" aria-label="设置定时计划" wx:if="{{hasclock}}" catchtap="clock">
        <view class="home-mode-timer-icon">
          <text class="iconfont icon-clock"></text>
        </view>
        <view class="home-mode-timer-copy">
          <view class="home-mode-timer-title">定时计划</view>
          <view class="home-mode-timer-caption">单独设置定时，不改变当前状态</view>
        </view>
        <text class="home-mode-timer-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 天气详情弹层 -->
  <view class="weather-overlay" aria-role="button" aria-label="关闭天气详情" wx:if="{{showWeatherBox}}" bindtap="closeWeatherBox">
    <view class="weather-box" catchtap="noop">
      <!-- 关闭按钮 -->
      <text class="close-btn" aria-role="button" aria-label="关闭天气详情" catchtap="closeWeatherBox">×</text>
      <!-- 地点信息 -->
      <view class="location">
        <iconfont name="didian1" size="20" />
        <text class="location-text">{{locationText}}</text>
      </view>
      <!-- 天气图标 -->
      <view class="weather-icon">
        <iconfont name="{{weatherIconName}}" size="55" />
      </view>
      <!-- 温度 -->
      <view class="temperature2">
        <text>{{weatherDetail.temperature}}℃</text>
      </view>
      <!-- 天气情况 -->
      <view class="weather-condition">
        <text>{{weatherDetail.weather}}</text>
      </view>
      <!-- 湿度 -->
      <view class="humidity2">
        <iconfont name="shidu1" size="30" />
        <text decode="{{true}}">&nbsp;&nbsp;&nbsp;湿度</text>
        <text class="humidity-value">{{weatherDetail.sd}}</text>
      </view>
      <!-- 露点 -->
      <view class="dew-point2">
        <iconfont name="humidity" size="30" />
        <text decode="{{true}}">&nbsp;&nbsp;&nbsp;露点</text>
        <text class="dew-point-value">{{dewPoint}}℃</text>
      </view>
      <!-- PM2.5 -->
      <view class="pm252">
        <iconfont name="pm25" size="30" />
        <text decode="{{true}}">&nbsp;&nbsp;&nbsp;PM2.5</text>
        <text class="pm25-value">{{weatherDetail.pm2_5}}μg/m³</text>
      </view>
    </view>
  </view>
</view>
