/* pages/usermanage/usermanage.wxss */
/* Import CuIcon first to allow overrides */
@import "/colorui/icon.wxss";
@import "/colorui/main.wxss";

.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.card-container {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  width: 100%;
}

.card-item {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.card-item::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #38f9d7 0%, #43e97b 100%);
  opacity: 0.8;
}

.card-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-content {
  display: flex;
  align-items: center;
}

.card-icon {
  font-size: 72rpx !important;
  color: #333333;
  margin-right: 40rpx;
  background-color: #f5f5f5;
  padding: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #888888;
}

.card-arrow {
  font-size: 36rpx;
  color: #dddddd;
}
