page { min-height: 100%; background: linear-gradient(180deg,#f7fbf9,#eef5f3); }
.container { box-sizing: border-box; min-height: 100vh; padding: 44rpx 28rpx; background: transparent; }
.card-container { display: flex; width: 100%; flex-direction: column; gap: 18rpx; }
.card-item { position: relative; padding: 26rpx; overflow: hidden; border: 1rpx solid var(--ui-border); border-radius: 26rpx; background: #fff; box-shadow: var(--ui-shadow-soft); }
.card-item::after { content: ""; position: absolute; top: -60rpx; right: -40rpx; width: 150rpx; height: 150rpx; border-radius: 50%; background: rgba(31,166,137,.07); }
.card-item:active { opacity: .78; transform: scale(.985); }
.card-content { position: relative; display: flex; align-items: center; }
.card-icon { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 76rpx; height: 76rpx; margin-right: 19rpx; padding: 0; border-radius: 23rpx; color: var(--ui-primary); background: var(--ui-primary-soft); font-size: 35rpx !important; }
.card-info { display: flex; flex: 1; flex-direction: column; }
.card-title { color: var(--ui-text); font-size: 29rpx; font-weight: 630; }
.card-desc { margin-top: 7rpx; color: var(--ui-text-muted); font-size: 21rpx; }
.card-arrow { color: #a4b2ad; font-size: 34rpx; }
