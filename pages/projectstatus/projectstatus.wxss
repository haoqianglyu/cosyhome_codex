page {
  min-height: 100%;
  background: linear-gradient(180deg, #f7fbf9 0%, #eef5f3 100%);
  color: var(--ui-text);
}

.page-container {
  padding: 28rpx 28rpx 190rpx;
}

.summary-card,
.info-card,
.warning-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 26rpx;
  background: #fff;
  box-shadow: var(--ui-shadow-soft);
}

.title-row,
.section-header,
.info-row,
.warning-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  color: var(--ui-text);
  font-size: 38rpx;
  font-weight: 600;
}

.status-text {
  padding: 7rpx 16rpx;
  border-radius: 18rpx;
  color: var(--ui-primary-dark);
  background: var(--ui-primary-soft);
  font-size: 22rpx;
}

.status-loading {
  color: #9a6700;
  background: #fff5d6;
}

.check-time {
  display: block;
  margin-top: 18rpx;
  color: #8a94a3;
  font-size: 25rpx;
}

.info-row {
  min-height: 76rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.info-row-last {
  border-bottom: 0;
}

.info-label {
  flex-shrink: 0;
  color: #7b8491;
  font-size: 27rpx;
}

.info-value {
  margin-left: 30rpx;
  color: var(--ui-text);
  font-size: 28rpx;
  text-align: right;
  word-break: break-all;
}

.section-header {
  margin-bottom: 22rpx;
}

.section-title {
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 600;
}

.warning-count {
  color: #d94841;
  font-size: 24rpx;
}

.warning-item {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #e55b55;
  border-radius: 12rpx;
  background: #fff7f6;
}

.warning-item:last-child {
  margin-bottom: 0;
}

.warning-device {
  color: #303642;
  font-size: 29rpx;
  font-weight: 600;
}

.warning-content {
  margin-top: 12rpx;
  color: #4e5663;
  font-size: 28rpx;
  line-height: 1.55;
}

.warning-meta {
  align-items: flex-end;
  margin-top: 16rpx;
  color: #9098a5;
  font-size: 23rpx;
}

.alarm-value {
  flex-shrink: 0;
  margin-right: 20rpx;
  color: #d94841;
}

.warning-time {
  text-align: right;
}

.warning-meta-stacked {
  display: block;
}

.warning-meta-stacked .alarm-value,
.warning-meta-stacked .warning-time {
  display: block;
}

.warning-meta-stacked .warning-time {
  margin-top: 10rpx;
  text-align: left;
}

.empty-state {
  padding: 55rpx 0;
  color: #98a0ac;
  font-size: 27rpx;
  text-align: center;
}

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(31, 45, 61, 0.08);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(31, 45, 61, 0.08);
}

.refresh-button {
  width: 100%;
  height: 88rpx;
  border: 0;
  border-radius: 44rpx;
  color: #fff;
  background: linear-gradient(135deg, #55c2bb, #55c2bb);
  box-shadow: 0 10rpx 22rpx rgba(24, 140, 118, 0.24);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.refresh-button::after {
  border: 0;
}

.refresh-button[disabled] {
  color: rgba(255, 255, 255, 0.85);
  background: #9ccdc0;
  box-shadow: none;
}
