page {
  height: 100%;
  overflow: hidden;
  background: #f4f8f6;
}

.splash {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #e7f7f1 0%, #f5f8f7 48%, #f4f6f8 100%);
}

.splash__decoration {
  position: absolute;
  border-radius: 50%;
  background: rgba(83, 199, 158, 0.09);
  filter: blur(2rpx);
}

.splash__decoration--top {
  top: -240rpx;
  right: -210rpx;
  width: 560rpx;
  height: 560rpx;
}

.splash__decoration--bottom {
  bottom: -300rpx;
  left: -260rpx;
  width: 620rpx;
  height: 620rpx;
  background: rgba(73, 143, 214, 0.06);
}

.splash__brand {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28vh;
  animation: splash-brand-in 0.75s ease-out both;
}

.splash__logo-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 470rpx;
  height: 190rpx;
}

.splash__logo {
  position: relative;
  z-index: 2;
  width: 400rpx;
}

.splash__logo-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 2rpx solid rgba(61, 179, 137, 0.18);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: splash-ring 2.4s infinite ease-out;
}

.splash__logo-ring--outer {
  width: 460rpx;
  height: 180rpx;
}

.splash__logo-ring--inner {
  width: 410rpx;
  height: 145rpx;
  animation-delay: 0.8s;
}

.splash__slogan {
  margin-top: 24rpx;
  color: #77837f;
  font-size: 26rpx;
  letter-spacing: 6rpx;
}

.splash__status {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 180rpx;
  margin-top: 105rpx;
  animation: splash-status-in 0.6s 0.25s ease-out both;
}

.splash__dots {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 30rpx;
}

.splash__dot {
  width: 16rpx;
  height: 16rpx;
  margin: 0 8rpx;
  border-radius: 50%;
  background: #3db389;
  animation: splash-bounce 1.2s infinite ease-in-out;
}

.splash__dot:nth-child(2) {
  animation-delay: 0.15s;
}

.splash__dot:nth-child(3) {
  animation-delay: 0.3s;
}

.splash__hint {
  margin-top: 28rpx;
  color: #8a9591;
  font-size: 25rpx;
  letter-spacing: 2rpx;
}

.splash__footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  margin-bottom: calc(40rpx + env(safe-area-inset-bottom));
  color: #9ca6a2;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  animation: splash-footer-in 0.8s 0.45s ease-out both;
}

@keyframes splash-bounce {
  0%,
  80%,
  100% {
    opacity: 0.35;
    transform: translateY(0) scale(0.9);
  }
  40% {
    opacity: 1;
    transform: translateY(-15rpx) scale(1.08);
  }
}

@keyframes splash-ring {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.88);
  }
  35% {
    opacity: 0.75;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.12);
  }
}

@keyframes splash-brand-in {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes splash-status-in {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes splash-footer-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
