/* pages/user/user.wxss */
.main_container {
  height: 100%;
  margin-bottom: 15vh;
}
.user_info_wrap {
  height: 25vh;
  margin: 30rpx 30rpx 15rpx 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.user_info_wrap .user_img_wrap {
  position: relative;
}
.user_info_wrap .user_img_wrap .user_bg {
  width: 100%;
  object-fit: cover;
  filter: blur(4rpx);
  height: 25vh;
}
.user_info_wrap .user_img_wrap .user_info {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}
.user_info_wrap .user_img_wrap .user_info .user_icon {
  z-index: 100;
  overflow: hidden;
  display: block;
  width: 8vh;
  height: 8vh;
  margin: 0 auto;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 3px 3px 10px rgba(0, 0, 0, 0.2);
}
.user_info_wrap .user_img_wrap .user_info .user_nickname {
  margin-top: 1vh;
  margin-left: 0;
  color: #fff;
  font-size: 28rpx;
}
.user_info_wrap .user_btn {
  padding: 1.5vh;
}
.user_info_wrap .user_btn button {
  width: 60%;
}
.padding.flex.text-center.text-grey.bg-white.shadow {
  margin-top: 2.8vh;
  margin-left: 2.5vh;
  margin-right: 2.5vh;
  border-radius: 1.5vh;
}
.padding.flex.text-center.text-grey.bg-white.shadow text {
  font-size: 70rpx;
}
.cu-list.menu > .cu-item {
  min-height: 100rpx;
}
/* 适应页面的全局边距 */
.transfer {
  margin-left: 15rpx;
  /* 假设值，需要根据你的实际布局来调整 */
  margin-right: 15rpx;
}
/* 保持按钮之间的间距 */
.button-group {
  display: flex;
  justify-content: space-between;
  padding: 0;
  /* 确保没有内边距干扰对齐 */
}
.button-left {
  margin-right: 10px;
  /* 可以根据需要调整间距大小 */
}
.button-right {
  margin-left: 10px;
  /* 保持与 button-left 相同的间距以对称 */
}
/* 网格菜单样式 */
.menu-grid-container {
  padding: 0 40rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.menu-grid-item {
  width: 48%;
  height: 120rpx;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1), 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.menu-grid-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15), 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.menu-item-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  text-decoration: none;
}

.menu-icon {
  font-size: 40rpx !important;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #666 !important;
}

page {
  background-image: url("https://cosyminiprogram.oss-cn-hangzhou.aliyuncs.com/cloud_pic/bg.png");
  background-size: 100% 130%;
}
