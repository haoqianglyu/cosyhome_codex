page {
  min-height: 100%;
  background: linear-gradient(180deg, #edf8f4 0, var(--ui-bg) 360rpx);
}

.main-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}

.top-controls,
.tab-content {
  box-sizing: border-box;
  border: 1rpx solid var(--ui-border);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-surface);
  box-shadow: var(--ui-shadow-soft);
}

.top-controls {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin-bottom: 24rpx;
  padding: 30rpx;
}

.control-group.left,
.control-group.right {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.key,
.label {
  color: var(--ui-text);
  font-size: 29rpx;
  font-weight: 600;
}

.btn-group {
  display: flex;
  box-sizing: border-box;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--ui-primary-soft);
}

.mode-btn {
  min-width: 122rpx;
  height: 62rpx;
  margin: 0 !important;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  color: var(--ui-text-secondary);
  background: transparent;
  font-size: 27rpx;
  line-height: 62rpx;
}

.mode-btn::after {
  border: 0;
}

.btn-active {
  color: #fff;
  background: var(--ui-primary);
  box-shadow: 0 8rpx 20rpx rgba(85, 194, 187, 0.2);
}

.tabs {
  display: flex;
  gap: 8rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.8);
}

.tab,
.tab-active {
  flex: 1;
  padding: 20rpx 4rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 27rpx;
}

.tab {
  color: var(--ui-text-secondary);
}

.tab-active {
  color: #fff;
  background: linear-gradient(135deg, var(--ui-primary), #55c2bb);
  box-shadow: 0 10rpx 24rpx rgba(85, 194, 187, 0.2);
}

.tab-content {
  min-height: 360rpx;
  padding: 24rpx 30rpx 30rpx;
}

.time-picker-blocks {
  display: flex;
  flex-direction: column;
}

.cu-form-group {
  min-height: 112rpx;
  padding: 0;
  border-bottom: 1rpx solid var(--ui-border);
  background: transparent;
}

.title {
  color: var(--ui-text-secondary);
  font-size: 25rpx;
}

.picker {
  color: var(--ui-text);
  font-size: 29rpx;
  font-weight: 600;
}

.notice {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(85, 194, 187, 0.18);
  border-radius: 18rpx;
  color: #55c2bb;
  background: var(--ui-primary-soft);
  font-size: 25rpx;
  line-height: 1.7;
}

.buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 38rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 600;
}

.cancel-btn {
  color: var(--ui-text-secondary);
  border: 1rpx solid var(--ui-border);
  background: var(--ui-surface);
}

.confirm-btn {
  color: #fff;
  background: linear-gradient(135deg, var(--ui-primary), #55c2bb);
  box-shadow: 0 14rpx 28rpx rgba(85, 194, 187, 0.22);
}
