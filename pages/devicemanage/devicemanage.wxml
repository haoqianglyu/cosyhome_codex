<!-- pages/devicemanage/devicemanage.wxml -->
<view class="container">
    <view class="device-list" wx:if="{{devices.length > 0}}">
        <view class="device-item" wx:for="{{devices}}" wx:key="id">
            <view class="device-info">
                <text class="device-name">{{item.deviceDisplay}}</text>
                <text class="device-time">登录时间: {{item.loginTimeDisplay}}</text>
            </view>
            <view class="device-action">
                <button class="logout-btn" size="mini" bindtap="handleLogout" data-id="{{item.id}}" data-name="{{item.deviceDisplay}}">
                    下线
                </button>
            </view>
        </view>
    </view>
    <view class="empty-state" wx:else>
        <text>暂无登录设备</text>
    </view>
</view>