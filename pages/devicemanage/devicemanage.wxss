page { min-height: 100%; background: linear-gradient(180deg,#f7fbf9,#eef5f3); }
.device-page { box-sizing: border-box; min-height: 100vh; padding: 34rpx 26rpx; }
.page-heading { padding: 8rpx 8rpx 28rpx; }
.heading-eyebrow { color: var(--ui-primary); font-size: 17rpx; font-weight: 650; letter-spacing: 3rpx; }
.heading-title { margin-top: 10rpx; color: var(--ui-text); font-size: 39rpx; font-weight: 680; }
.heading-copy { margin-top: 9rpx; color: var(--ui-text-muted); font-size: 22rpx; }
.security-banner { display: flex; align-items: center; padding: 24rpx; border: 1rpx solid #dcebe6; border-radius: 24rpx; background: linear-gradient(140deg,#edf9f5,#f7fbfa); }
.banner-icon { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; margin-right: 17rpx; border-radius: 21rpx; color: var(--ui-primary); background: #fff; font-size: 31rpx; box-shadow: var(--ui-shadow-soft); }
.banner-title { color: var(--ui-text); font-size: 26rpx; font-weight: 600; }
.banner-copy { margin-top: 6rpx; color: var(--ui-text-muted); font-size: 20rpx; }
.list-meta { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 7rpx 17rpx; color: var(--ui-text); font-size: 28rpx; font-weight: 600; }
.list-meta text:last-child { color: var(--ui-text-muted); font-size: 20rpx; font-weight: 400; }
.device-item { display: flex; align-items: center; min-height: 108rpx; margin-bottom: 15rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--ui-border); border-radius: 23rpx; background: #fff; box-shadow: var(--ui-shadow-soft); }
.device-icon { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; margin-right: 16rpx; border-radius: 21rpx; color: #438da7; background: #eaf5f7; font-size: 32rpx; }
.device-info { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.device-name { overflow: hidden; color: var(--ui-text); font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.device-time { margin-top: 7rpx; color: var(--ui-text-muted); font-size: 19rpx; }
.logout-btn { flex-shrink: 0; width: 102rpx; height: 58rpx; margin: 0 0 0 14rpx; padding: 0; border: 1rpx solid #f0cccc; border-radius: 29rpx; color: #ce6262; background: #fff5f5; font-size: 22rpx; line-height: 58rpx; }
.empty-state { display: flex; min-height: 500rpx; flex-direction: column; align-items: center; justify-content: center; color: var(--ui-text-muted); }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; border-radius: 35rpx; color: var(--ui-primary); background: var(--ui-primary-soft); font-size: 48rpx; }
.empty-title { margin-top: 25rpx; color: var(--ui-text-secondary); font-size: 28rpx; font-weight: 600; }
.empty-copy { margin-top: 9rpx; font-size: 21rpx; }
