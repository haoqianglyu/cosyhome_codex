<view class="verification-page">
  <view class="verification-glow glow-top"></view>
  <view class="verification-glow glow-bottom"></view>

  <view class="verification-header">
    <view class="shield-mark">
      <text class="cuIcon-safe shield-icon"></text>
    </view>
    <view class="verification-kicker">安全验证</view>
    <view class="verification-title">输入短信验证码</view>
    <view class="verification-description">{{sendStatus === 'sending' ? '正在发送验证码至' : (sendStatus === 'sent' ? '验证码已发送至' : '接收验证码的手机号')}}</view>
    <view class="phone-pill">+86 {{phone}}</view>
  </view>

  <view class="code-card">
    <view class="code-label">4 位验证码</view>
    <view class="code-entry">
      <view class="code-boxes" aria-hidden="true">
        <view wx:for="{{[0, 1, 2, 3]}}" wx:key="*this" class="code-box {{currentInput[item] ? 'code-box-filled' : ''}} {{inputFocused && currentInput.length === item ? 'code-box-active' : ''}} {{errorCode ? 'code-box-error' : ''}}">
          <text>{{currentInput[item] || ''}}</text>
          <view wx:if="{{inputFocused && currentInput.length === item}}" class="code-caret"></view>
        </view>
      </view>
      <!-- 单个原生输入层承接键盘、删除和整段粘贴，四格仅负责展示。 -->
      <input class="code-native-input" type="number" maxlength="32" value="{{currentInput}}" focus="{{inputFocused}}" disabled="{{!phoneValid || sendStatus === 'sending' || verifying || bound}}" bindinput="onCodeInput" bindfocus="onCodeFocus" bindblur="onCodeBlur" bindconfirm="verifyCode" confirm-type="done" aria-label="4 位短信验证码，可长按粘贴" />
    </view>
    <view class="error-message {{errorCode ? 'error-visible' : ''}}">{{errorCode}}</view>
    <view class="code-tip">{{bound ? '绑定成功，正在进入首页' : (verifying ? '正在验证，请稍候' : '支持长按粘贴，输入满 4 位后自动验证')}}</view>
    <button wx:if="{{errorCode && currentInput.length === 4}}" class="verify-retry" bindtap="verifyCode" disabled="{{verifying || bound || sendStatus === 'sending'}}">重新验证</button>

    <view class="resend-section">
      <view class="send-error" wx:if="{{sendStatus === 'error'}}">{{sendError}}</view>
      <button class="resend-button" bindtap="handleSendVerify" loading="{{sendStatus === 'sending'}}" disabled="{{!phoneValid || sendStatus === 'sending' || cooldown > 0 || verifying || bound}}">{{sendStatus === 'sending' ? '正在发送' : (cooldown > 0 ? cooldown + ' 秒后可重发' : (sendStatus === 'error' ? '重新发送验证码' : '重新获取验证码'))}}</button>
      <view class="resend-tip" wx:if="{{sendStatus === 'sent' && !bound}}">未收到短信？请稍后重发，或返回检查手机号</view>
    </view>
  </view>

  <view class="verification-footer">请勿向任何人透露验证码</view>
</view>
