page {
  min-height: 100%;
  background: #f3f8f5;
  color: #17271f;
}

.verification-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 72rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  background: linear-gradient(168deg, #e8f8f0 0%, #f6faf8 42%, #f2f6f4 100%);
}

.verification-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.glow-top {
  top: -240rpx;
  right: -180rpx;
  width: 560rpx;
  height: 560rpx;
  background: rgba(50, 205, 140, 0.16);
}

.glow-bottom {
  bottom: -300rpx;
  left: -240rpx;
  width: 600rpx;
  height: 600rpx;
  background: rgba(115, 218, 174, 0.1);
}

.verification-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.shield-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 44rpx rgba(25, 151, 98, 0.14);
}

.shield-icon {
  color: #55c2bb;
  font-size: 56rpx;
}

.verification-kicker {
  margin-top: 22rpx;
  color: #55c2bb;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.verification-title {
  margin-top: 8rpx;
  color: #172b22;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.4;
}

.verification-description {
  margin-top: 12rpx;
  color: #7d8b84;
  font-size: 26rpx;
}

.phone-pill {
  margin-top: 13rpx;
  padding: 10rpx 22rpx;
  border: 1rpx solid #d5e9df;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.75);
  color: #2b5b46;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.code-card {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  margin-top: 40rpx;
  padding: 32rpx 30rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 22rpx 64rpx rgba(31, 75, 56, 0.09);
}

.code-label {
  color: #4c6057;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.code-entry {
  position: relative;
  width: 502rpx;
  max-width: 100%;
  height: 116rpx;
  margin: 23rpx auto 0;
}

.code-boxes {
  display: flex;
  height: 100%;
  gap: 18rpx;
  pointer-events: none;
}

.code-box {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 100%;
  border: 2rpx solid #dce8e2;
  border-radius: 22rpx;
  background: #f6faf8;
  color: #183329;
  font-size: 50rpx;
  font-weight: 700;
  transition: border-color 0.18s, background 0.18s, box-shadow 0.18s;
}

.code-box-filled, .code-box-active {
  border-color: #55c2bb;
  background: #edfaf4;
  box-shadow: 0 9rpx 20rpx rgba(32, 174, 113, 0.11);
}

.code-box-error { border-color: #df5d5d; color: #df5d5d; }

.code-caret {
  width: 3rpx;
  height: 42rpx;
  border-radius: 2rpx;
  background: #55c2bb;
}

.code-native-input {
  position: absolute;
  z-index: 2;
  top: 0;
  left: 0;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border: 0;
  background: transparent;
  color: transparent;
  caret-color: transparent;
  font-size: 50rpx;
}

.error-message {
  min-height: 36rpx;
  margin-top: 16rpx;
  color: transparent;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.error-visible {
  color: #df5d5d;
}

.code-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b9892;
  font-size: 22rpx;
}

.resend-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e5ede9;
  text-align: center;
}

.resend-button, .verify-retry {
  border-radius: 18rpx;
  background: #e9f8f1;
  color: #278c79;
  font-size: 28rpx;
  line-height: 84rpx;
}

.resend-button::after, .verify-retry::after { border: none; }
.resend-button[disabled], .verify-retry[disabled] { background: #f2f5f3; color: #96a29b; }
.verify-retry { margin-top: 20rpx; }
.send-error { margin-bottom: 16rpx; color: #df5d5d; font-size: 24rpx; }
.resend-tip { margin-top: 16rpx; color: #8b9892; font-size: 22rpx; line-height: 1.6; }

.verification-footer {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  color: #95a19b;
  font-size: 21rpx;
  text-align: center;
}
