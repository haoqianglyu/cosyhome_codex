<view class="equipment-page">
  <view class="equipment-drawer" style="background-color:{{color}}">
    <view class="drawer-heading">设备分类</view>
    <view class="drawer-caption">选择需要查看的系统</view>
    <view class="drawer-list">
      <button class="drawer-item {{current_item === index ? 'drawer-item-active' : ''}}" bindtap="clicked" wx:for="{{menuList_name}}" wx:key="*this" data-key="{{index}}">
        <view class="drawer-dot"></view><text>{{item}}</text>
      </button>
    </view>
  </view>

  <view bindtouchmove="tap_drag" bindtouchstart="tap_start" class="equipment-main {{open ? 'main-shifted' : ''}}">
    <view class="main-header">
      <view class="menu-trigger" aria-role="button" aria-label="切换设备分类" bindtap="tap_ch">
        <view></view><view></view><view></view>
      </view>
      <view class="header-copy">
        <view class="header-eyebrow">EQUIPMENT DATA</view>
        <view class="header-title" wx:if="{{menu_number <= 1 && titles}}">{{titles}}</view>
        <view class="header-title" wx:else>设备运行参数</view>
      </view>
      <view class="online-chip"><view class="online-dot"></view>在线</view>
    </view>

    <view class="device-select" wx:if="{{menu_number >= 2}}">
      <view class="select-label">当前设备</view>
      <view class="select-box">
        <view class="select" aria-role="button" aria-label="选择设备" catchtap="selectTap">
          <text class="select-text">{{titles[index2]}}</text><view class="select-arrow {{show ? 'select-arrow-open' : ''}}"></view>
        </view>
        <view class="option-box {{show ? 'option-box-open' : ''}}">
          <view class="option" aria-role="button" aria-label="选择 {{item}}" wx:for="{{titles}}" wx:key="*this" wx:for-index="deviceIndex" data-index="{{deviceIndex}}" catchtap="optionTap">{{item}}</view>
        </view>
      </view>
    </view>

    <scroll-view scroll-y class="parameter-scroll" scroll-top="{{scrollTop}}">
      <view wx:if="{{isLoading}}" class="loading-state">
        <view class="loading-ring"></view><text>正在读取设备数据</text>
      </view>
      <view wx:elif="{{content.length}}" class="parameter-card">
        <view class="parameter-row" wx:for="{{content}}" wx:key="title">
          <view class="parameter-key">{{item.title}}</view>
          <view class="parameter-value">{{item.value}}</view>
        </view>
      </view>
      <view wx:else class="empty-state">
        <view class="empty-icon cuIcon-apps"></view><view class="empty-title">暂无设备数据</view><view class="empty-copy">请切换设备后重试</view>
      </view>
    </scroll-view>
  </view>
</view>
