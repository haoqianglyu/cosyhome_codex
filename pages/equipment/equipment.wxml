<view class="page">
  <view class="page-bottom" style="background-color:{{color}}">
    <view class="page-content">
      <button class="items {{index}} {{current_item === index?'selected':' '}}"  bindtap='clicked'  
      wx:for="{{menuList_name}}" data-key='{{index}}'><text>{{item}}</text></button>
    </view> 
  </view>
    

  <view bindtouchmove="tap_drag" bindtouchstart="tap_start" class="page-top {{ open ? 'c-state1' : '' }}" wx:for="{{menuList_name}}" wx:if="{{current_item === index}}" data-key='{{index}}'>
    <!-- <view class="right_content" wx:for="{{menuList_name}}" wx:if="{{current_item === index}}" data-key='{{index}}'>
      
    </view> -->
    <image  class="nav" bindtap="tap_ch" src="../../icons/btn_2.png" style="margin-top:20rpx"></image>
      <!-- Original title display commented out -->
      <!-- <view class="title" wx:if="{{menu_number<=1?true:false}}">{{titles}}</view> -->
      
      <!-- Special display for connection status -->
      <view class="title" wx:if="{{menu_number<=1 && titles}}">{{titles}}</view>
      
      <view class='select_box' wx:if="{{menu_number>=2?true:false}}">
        <view class='select' catchtap='selectTap'>
          <text class='select_text'>{{titles[index2]}}</text>
          <image class='select_img {{show&&"select_img_rotate"}}' src='/icons/gobottom.png'></image>   
        </view>
        
        <view class='option_box' style='height:{{show?(titles.length>5?300:titles.length*60):0}}rpx;'>
            <view class='option' style='{{index==titles.length-1&&"border:0;"}}' wx:for='{{titles}}' wx:key='this' data-index='{{index}}' catchtap='optionTap'>{{item}}</view>
        </view>
      </view>

      <view class="wc1_content">
        <view class="left">
            <image class="gif" src="../../icons/anim.gif" wx:if="{{!open_gif}}"></image>
        </view>
        <scroll-view scroll-y="true" style="flex: 90;height: 85vh;margin-top: 4vh;margin-left:1.5vw;margin-right:10vw;" scroll-top="{{scrollTop}}">
       
            <view class='text-content' wx:for="{{content}}" data-key='{{index}}'>
                
                      <view class="children">
                        <view class="key">{{item.title}}</view>
                        <view class="value">{{item.value}}</view>
                      </view>
                      
                      
            </view>
       
        </scroll-view>
      </view>
      
  </view>
</view>
