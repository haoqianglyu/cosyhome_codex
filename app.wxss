/**app.wxss**/
@import "icon.wxss";
@import "my_icon.wxss";
@import "main.wxss";
@import "colorui/main.wxss";
@import "styles/comfort-tech.wxss";

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f3f7f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
