<view class="tab-bar-wrapper">
  <view class="tab-bar">
    <view wx:for="{{list}}" wx:key="pagePath" class="tab-bar-item" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab" aria-role="button" aria-label="切换到{{item.text}}">
      <view class="tab-icon-circle {{selected === index ? 'tab-icon-circle--active' : ''}}">
        <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit"></image>
        <view class="tab-label {{selected === index ? 'tab-label--active' : ''}}">{{item.text}}</view>
      </view>
    </view>
  </view>
</view>
