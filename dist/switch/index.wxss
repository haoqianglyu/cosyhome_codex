.i-switch {
  position: relative;
  display: inline-block;
  width: 48px;
  height: 24px;
  border: 1px solid #ccc;
  border-radius: 24px;
  background-color: #ccc;
  line-height: 24px;
  vertical-align: middle;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  -webkit-tap-highlight-color: transparent;
}

.i-switch-hide-input {
  display: none;
  opacity: 0;
}

.i-switch-inner {
  position: absolute;
  left: 25px;
  color: #fff;
  font-size: 12px;
  vertical-align: middle;
}

.i-switch-inner .i-icon {
  width: 12px;
  height: 12px;
  text-align: center;
  vertical-align: middle;
}

.i-switch::after {
  position: absolute;
  top: 1px;
  left: 1px;
  width: 20px;
  height: 20px;
  border-radius: 22px;
  background-color: #fff;
  content: "";
  cursor: pointer;
  transition: left 0.2s ease-in-out, width 0.2s ease-in-out;
}

.i-switch-checked {
  border-color: #55c2bb;
  background-color: #55c2bb;
}

.i-switch-checked .i-switch-inner {
  left: 8px;
}

.i-switch-checked::after {
  left: 25px;
}

.i-switch-large {
  width: 60px;
  height: 30px;
  border-radius: 30px;
  line-height: 30px;
}

.i-switch-large .i-switch-inner {
  left: 32px;
  font-size: 13px;
}

.i-switch-large::after {
  top: 1px;
  left: 1px;
  width: 26px;
  height: 26px;
}

.i-switch-large.i-switch-checked .i-switch-inner {
  left: 10px;
}

.i-switch-large.i-switch-checked::after {
  left: 31px;
}

.i-switch-disabled {
  border-color: #f3f3f3;
  background: #f3f3f3;
}

.i-switch-disabled::after {
  background: #ccc;
  cursor: not-allowed;
}

.i-switch-disabled .i-switch-inner {
  color: #ccc;
}
